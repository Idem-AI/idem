# ═══════════════════════════════════════════════════════════════════════════
# Environnement de DÉVELOPPEMENT du monorepo (docker-compose.dev.yml)
#
# Copier en `.env.dev` (lien `.env` → `.env.dev`). Ce fichier alimente les
# conteneurs de dev et les builds locaux des fronts ; il n'est JAMAIS commité.
# Chaque backend a aussi son propre exemple (apps/*/.env.example), qui fait
# foi pour ses variables. En production, les secrets de l'API, d'AppGen et
# d'ideploy-api sont lus dans Google Secret Manager (`<app>--<VARIABLE>`).
# Les valeurs FIREBASE_API_KEY/AUTH_DOMAIN/… sont publiques ; toutes les
# autres clés, jetons et mots de passe ne doivent jamais apparaître dans un
# fichier suivi par git ni dans un bundle front.
# ═══════════════════════════════════════════════════════════════════════════

# ==================== FIREBASE CONFIGURATION ====================
# Firebase Auth & Admin SDK
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-content\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id

# ==================== DATABASE CONFIGURATION ====================
# PostgreSQL (for Ideploy/Coolify)
DB_DATABASE=coolify
DB_USERNAME=coolify
DB_PASSWORD=password
DB_HOST=postgres
DB_PORT=5432
FORWARD_DB_PORT=5432

# MongoDB (for API)
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/idem?authSource=admin
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=admin123
MONGODB_DATABASE=idem

# ==================== REDIS CONFIGURATION ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=Idem
FORWARD_REDIS_PORT=6379

# ==================== MINIO CONFIGURATION ====================
# MinIO S3-compatible object storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=idem-storage2

# ==================== AI CONFIGURATION ====================
# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Claude
CLAUDE_API_KEY=your-claude-api-key

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key

# AI Generation Limits
AI_PROVIDER=gemini

# ==================== API SERVICE CONFIGURATION ====================
API_PORT=3010
API_URL=http://localhost:3010
PORT=3001
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:3003,http://localhost:3004,http://localhost:8000

# ==================== IDEPLOY/COOLIFY CONFIGURATION ====================
APP_KEY=base64:your-app-key-here
APP_PORT=8000
LOG_LEVEL=error
SSH_MUX_ENABLED=false
IDEM_API_URL=http://api:3000

# Pusher/Soketi Configuration
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_ID=coolify
PUSHER_APP_KEY=coolify
PUSHER_APP_SECRET=coolify
FORWARD_SOKETI_PORT=6001

# ==================== VITE CONFIGURATION ====================
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:3001

# Mermaid/Chart Configuration
VITE_MERMAID_DOMAIN=
VITE_MERMAID_ANALYTICS_URL=
VITE_MERMAID_RENDERER_URL=https://mermaid.ink
VITE_MERMAID_KROKI_RENDERER_URL=https://kroki.io
VITE_MERMAID_IS_ENABLED_MERMAID_CHART_LINKS=

# ==================== APPGEN CONFIGURATION ====================
APPGEN_PORT=3003
CHART_PORT=3004

# React App (we-dev-client)
REACT_APP_BASE_URL=http://localhost:3000
REACT_APP_IDEM_API_BASE_URL=http://localhost:3001
REACT_APP_IDEM_MAIN_APP_URL=http://localhost:4200
REACT_APP_NEXT_API_BASE_URL=http://localhost:3000

# Next.js (we-dev-next)
THIRD_API_URL=https://generativelanguage.googleapis.com/v1beta
THIRD_API_KEY=your-third-api-key
IDEM_FRONTEND_URL=https://idem.africa

# Netlify Deployment
NETLIFY_TOKEN=your-netlify-token
NETLIFY_DEPLOY_URL=https://api.netlify.com/api/v1/sites

# ==================== EMAIL CONFIGURATION ====================
# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password

# Email Service
EMAIL_FROM=noreply@idem.africa

# ==================== SECURITY & ENCRYPTION ====================
SENSITIVE_VARS_ENCRYPTION_KEY=your-encryption-key-min-32-characters
INTERNAL_API_KEY=your-secure-api-key-here-change-in-production

# ==================== PRODUIT ET LIMITES ====================
IS_BETA=true
MIN_INPUT_LENGTH=10
MAX_INPUT_LENGTH=5000

# ==================== AUTHORIZATION ====================
ADMIN_EMAILS=admin@example.com

# ==================== GITHUB INTEGRATION ====================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3001/github/auth/callback

# ==================== USER & GROUP IDS (for Docker) ====================
USERID=1000
GROUPID=1000

# =====================================
# PAIEMENTS — pawaPay (Mobile Money)
# =====================================
# Jeton d'API émis depuis le tableau de bord pawaPay. Sans lui, aucun
# encaissement n'est possible : le client refuse de partir.
# Ce fichier est versionné : le jeton réel vit dans .env.dev (ignoré par git).
PAWAPAY_API_TOKEN=
# sandbox (défaut) ou production. Conditionne l'URL de base ET la liste
# blanche d'IP des callbacks.
PAWAPAY_ENV=sandbox
# Vérification de signature des callbacks : enforce | log | off.
# `log` observe sans bloquer — la relecture du statut protège déjà la
# livraison. Passer à `enforce` une fois la signature activée côté pawaPay.
PAWAPAY_CALLBACK_SIGNATURE=log
# Liste blanche d'IP surchargée (séparées par des virgules). À renseigner
# derrière un proxy ou un tunnel de développement, où l'IP vue par Express
# n'est pas celle de pawaPay. Vide = liste officielle selon PAWAPAY_ENV.
PAWAPAY_CALLBACK_IPS=
# Clé publique de secours pour vérifier les signatures, au format PEM.
# Optionnelle : la clé est normalement lue sur /public-keys.
PAWAPAY_PUBLIC_KEY=
# URL de callback à déclarer dans le tableau de bord pawaPay :
#   https://api.idem.africa/billing/webhooks/pawapay/deposits
