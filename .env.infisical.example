# Config de la stack Infisical (docker-compose.infisical.yml).
# Copier en `.env.infisical` sur le serveur — jamais commité (voir .gitignore).

# URL publique de cette instance, celle mise dans INFISICAL_SITE_URL des 3 apps.
SITE_URL=https://secrets.idem.africa

# openssl rand -hex 16
ENCRYPTION_KEY=

# openssl rand -base64 32
AUTH_SECRET=

# Postgres dédié à Infisical (séparé des bases applicatives).
POSTGRES_USER=infisical
POSTGRES_PASSWORD=
POSTGRES_DB=infisical
DB_CONNECTION_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@infisical-db:5432/${POSTGRES_DB}

REDIS_URL=redis://infisical-redis:6379
