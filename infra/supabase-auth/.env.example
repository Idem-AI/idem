# Module d'authentification Supabase auto-hébergé — voir README.md.
# Copier en `.env` et remplir. Ce fichier contient des secrets : ne pas le versionner.

# URL publique de GoTrue (reverse proxy HTTPS en production).
AUTH_PUBLIC_URL=https://auth.idem.africa
AUTH_PORT=9999

# Page d'arrivée par défaut et redirections autorisées après connexion
# (séparées par des virgules, jokers ** acceptés).
AUTH_SITE_URL=https://console.idem.africa
AUTH_REDIRECT_ALLOW_LIST=https://console.idem.africa/**

# Base Postgres de GoTrue (générer avec : openssl rand -hex 24).
AUTH_DB_PASSWORD=
AUTH_ADMIN_PASSWORD=

# Secret de signature des jetons (≥ 32 caractères : openssl rand -hex 32).
# Même valeur que SUPABASE_JWT_SECRET côté API IDEM.
AUTH_JWT_SECRET=

# SMTP (confirmation d'adresse, mot de passe oublié, reprise des comptes migrés).
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_SENDER=no-reply@idem.africa
AUTH_SMTP_SENDER_NAME=IDEM

# Google — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ENABLED=true
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_SECRET=

# LinkedIn (OpenID Connect) — https://www.linkedin.com/developers/apps
AUTH_LINKEDIN_ENABLED=true
AUTH_LINKEDIN_CLIENT_ID=
AUTH_LINKEDIN_SECRET=
