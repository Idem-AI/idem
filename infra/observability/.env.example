# Copier en .env puis ajuster. Toutes les valeurs ont un défaut raisonnable
# pour le local : `docker compose up -d` marche aussi sans ce fichier.

# Destinataire(s) des alertes, séparés par « ; ».
ALERT_EMAIL_TO=equipe@idem.africa
ALERT_EMAIL_FROM=alertes@idem.africa

# Grafana
GRAFANA_PORT=3300
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3300

# SMTP. En local : Mailpit (http://localhost:8025), rien à changer.
# En production, par exemple :
#   SMTP_HOST=smtp.sendgrid.net:587
#   SMTP_USER=apikey
#   SMTP_PASSWORD=<clé>
#   SMTP_STARTTLS_POLICY=MandatoryStartTLS
#   SMTP_SKIP_VERIFY=false
SMTP_HOST=mailpit:1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS_POLICY=NoStartTLS
SMTP_SKIP_VERIFY=true
