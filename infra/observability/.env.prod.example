# Copy to .env.prod on the server (chmod 600). Never commit the real file.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# Public URL of Grafana, behind the reverse proxy. Used in alert e-mail links.
GRAFANA_ROOT_URL=https://monitoring.idem.africa
GRAFANA_PORT=3300
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Recipients of the alerts, separated by ";".
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=monitoring@idem.africa

# SMTP server (host:port). STARTTLS is required in production.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS_POLICY=MandatoryStartTLS
