{
  "uid": "idem-logs",
  "title": "IDEM · Journaux",
  "tags": [
    "idem",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Journaux des trois services (idem-api, ideploy-api, appgen) : activité, erreurs, latences, et relecture d'une requête par son requestId.",
