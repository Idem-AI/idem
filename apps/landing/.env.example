# ── Firebase (identifiants web publics) ─────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=lexis-ia.firebaseapp.com
FIREBASE_PROJECT_ID=lexis-ia
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ── Services ────────────────────────────────────────────────────────────────
SERVICES_DOMAIN=https://idem.africa
