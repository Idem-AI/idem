# ═══════════════════════════════════════════════════════════════════════════
# Landing IDEM — développement local
# Ces valeurs sont intégrées au bundle JavaScript servi aux visiteurs : elles
# sont PUBLIQUES. N'y mettez jamais de secret (clé privée, mot de passe, jeton).
# ═══════════════════════════════════════════════════════════════════════════

# ── Firebase (identifiants web publics) ─────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=lexis-ia.firebaseapp.com
FIREBASE_PROJECT_ID=lexis-ia
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ── Services ────────────────────────────────────────────────────────────────
SERVICES_DOMAIN=https://idem.africa
SERVICES_DASHBOARD_URL=http://localhost:4200
SERVICES_API_URL=http://localhost:3001

# ── Divers ──────────────────────────────────────────────────────────────────
WAITLIST_URL=
IS_BETA=true
ANALYTICS_ENABLED=false
