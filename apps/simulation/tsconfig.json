{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "paths": {
      "@core/*": ["./src/app/core/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@features/*": ["./src/app/features/*"],
      "@layouts/*": ["./src/app/layouts/*"],
      // Les paquets partagés vivent hors de `node_modules` : leur
      // `import ... from '@angular/core'` remonterait sinon jusqu'au Angular 20
      // hissé à la racine du monorepo, alors que cette application est en
      // Angular 22 — deux copies du framework, et des types incompatibles.
      "@angular/*": ["./node_modules/@angular/*"],
      "@idem/shared-tour": ["../../packages/shared-tour/src"],
      "@idem/shared-trusted-by": ["../../packages/shared-trusted-by/src"],
      "@idem/shared-trusted-by/*": ["../../packages/shared-trusted-by/src/*"],
      "@env": ["./src/environments/environment"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  }
}
