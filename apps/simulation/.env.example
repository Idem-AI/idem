# ---------------------------------------------------------------------------
# IDEM Simulator — production environment
# Same Firebase project as the IDEM dashboard: the auth session is shared.
# ---------------------------------------------------------------------------

FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

SERVICES_DOMAIN=https://idem.africa
SERVICES_SIMULATION_URL=https://simulation.idem.africa
SERVICES_API_URL=https://api.idem.africa
SERVICES_DASHBOARD_URL=https://console.idem.africa
SERVICES_LANDING_URL=https://idem.africa

# 'fr' or 'en'
DEFAULT_LANGUAGE=fr
# Source de données. Jamais true en production : l'application servirait le jeu
# de démonstration au lieu d'appeler l'API.
USE_MOCK_DATA=false
ANALYTICS_ENABLED=true
