# ---------------------------------------------------------------------------
# IDEM Simulator — production environment
# Aucune configuration d'identité ici : la connexion se fait sur le dashboard
# IDEM, qui pose le cookie de session partagé par toutes les applications.
# ---------------------------------------------------------------------------

SERVICES_DOMAIN=https://idem.africa
SERVICES_SIMULATION_URL=https://simulation.idem.africa
# API IDEM : authentification (/auth/profile, /auth/logout) et simulations.
SERVICES_API_URL=https://api.idem.africa
# Dashboard IDEM : le seul écran de connexion de l'écosystème.
SERVICES_DASHBOARD_URL=https://console.idem.africa
SERVICES_LANDING_URL=https://idem.africa

# 'fr' or 'en'
DEFAULT_LANGUAGE=fr
# Source de données. Jamais true en production : l'application servirait le jeu
# de démonstration au lieu d'appeler l'API.
USE_MOCK_DATA=false
ANALYTICS_ENABLED=true
