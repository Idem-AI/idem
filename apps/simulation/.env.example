# ---------------------------------------------------------------------------
# IDEM Simulator — production environment
# No identity configuration here: sign-in happens on the IDEM dashboard, which
# sets the session cookie shared by every app.
# ---------------------------------------------------------------------------

SERVICES_DOMAIN=https://idem.africa
SERVICES_SIMULATION_URL=https://simulator.idem.africa
# IDEM API: authentication (/auth/profile, /auth/logout) and simulations.
SERVICES_API_URL=https://api.idem.africa
# IDEM dashboard: the only sign-in screen of the ecosystem.
SERVICES_DASHBOARD_URL=https://console.idem.africa
SERVICES_LANDING_URL=https://idem.africa

# 'fr' or 'en'
DEFAULT_LANGUAGE=fr
ANALYTICS_ENABLED=true

# Product beta. true = prices are shown struck through and the simulation is
# announced as free; false = normal pricing is shown.
# Set back to false when the beta ends.
IS_BETA=true
