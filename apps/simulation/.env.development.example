# ---------------------------------------------------------------------------
# IDEM Simulator — local development
# Aucune configuration d'identité ici : la connexion se fait sur le dashboard
# IDEM, qui pose le cookie de session partagé par toutes les applications.
# Les ports localhost partagent leurs cookies, la session vaut donc d'une
# application à l'autre.
# ---------------------------------------------------------------------------

SERVICES_DOMAIN=http://localhost:4201
SERVICES_SIMULATION_URL=http://localhost:4203
# API IDEM : authentification (/auth/profile, /auth/logout) et simulations.
SERVICES_API_URL=http://localhost:3001
# Dashboard IDEM : le seul écran de connexion de l'écosystème.
SERVICES_DASHBOARD_URL=http://localhost:4200
SERVICES_LANDING_URL=http://localhost:4201

DEFAULT_LANGUAGE=fr
# Source de données. true = jeu de démonstration intégré, aucune requête API,
# et aucune session requise. Modifiable sans reconstruire : ?mock=on / ?mock=off
# dans l'URL, ou le commutateur « Données de démonstration » du menu compte.
USE_MOCK_DATA=true
ANALYTICS_ENABLED=false
