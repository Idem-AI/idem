# ---------------------------------------------------------------------------
# IDEM Simulator — local development
# No identity configuration here: sign-in happens on the IDEM dashboard, which
# sets the session cookie shared by every app. Localhost ports share cookies,
# so the session carries from one app to the other.
# ---------------------------------------------------------------------------

SERVICES_DOMAIN=http://localhost:4201
SERVICES_SIMULATION_URL=http://localhost:4203
# IDEM API: authentication (/auth/profile, /auth/logout) and simulations.
SERVICES_API_URL=http://localhost:3001
# IDEM dashboard: the only sign-in screen of the ecosystem.
SERVICES_DASHBOARD_URL=http://localhost:4200
SERVICES_LANDING_URL=http://localhost:4201

DEFAULT_LANGUAGE=fr
ANALYTICS_ENABLED=false

# Product beta. true = prices are shown struck through and the simulation is
# announced as free; false = normal pricing is shown.
# Set back to false when the beta ends.
IS_BETA=true
