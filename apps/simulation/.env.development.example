# ---------------------------------------------------------------------------
# IDEM Simulator — local development
# ---------------------------------------------------------------------------

FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

SERVICES_DOMAIN=http://localhost:4201
SERVICES_SIMULATION_URL=http://localhost:4203
SERVICES_API_URL=http://localhost:3010
SERVICES_DASHBOARD_URL=http://localhost:4200
SERVICES_LANDING_URL=http://localhost:4201

DEFAULT_LANGUAGE=fr
# The simulation API is not wired yet: keep the demo dataset on locally.
USE_MOCK_DATA=true
ANALYTICS_ENABLED=false
