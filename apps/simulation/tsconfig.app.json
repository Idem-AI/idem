{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    // Les paquets partagés (`@idem/*`) sont consommés en source depuis
    // `packages/` : la racine doit englober le dépôt, pas seulement l'app.
    "rootDir": "../..",
    "types": []
  },
  "files": ["src/main.ts"],
  "include": [
    "src/**/*.d.ts",
    "../../packages/shared-tour/src/**/*.ts",
    // Seuls le point d'entrée neutre et le rendu Angular : les rendus React et
    // Svelte du même paquet ne concernent pas cette application. Par le lien
    // `src/app/shared/shared-loader`, pas par `packages/` : avec
    // `preserveSymlinks`, son `@angular/core` est alors celui de l'app (22),
    // et non celui de la racine, absent de l'image Docker.
    "src/app/shared/shared-loader/src/index.ts",
    "src/app/shared/shared-loader/src/angular/**/*.ts"
  ]
}
