# ─── iDomain API — configuration (non sensible) ─────────────────────────────
# Copier en `.env`. Les SECRETS vont dans `.env.secret` (même dossier, jamais commité) en local,
# et dans Infisical (projet `idomain-api`) en production : voir src/config/secrets.ts.
PORT=3007
NODE_ENV=development

# L'API IDEM : identité (cookie `session`) et portefeuille (passerelle /internal/idomain).
IDEM_API_URL=http://localhost:3001
# L'API iDeploy : applications et rattachement des domaines (passerelle /internal/idomain).
IDEPLOY_API_URL=http://localhost:3002
# Le front iDomain (liens des parcours) et le tableau de bord IDEM.
IDOMAIN_WEB_URL=http://localhost:4205
IDEM_DASHBOARD_URL=http://localhost:4200
# Origines admises (iDomain web, iDeploy web, tableau de bord, iCode) : iDeploy et iCode appellent cette API
# directement depuis leurs pages (achat intégré). En production : https://ideploy.idem.africa, https://appgen.idem.africa…
IDOMAIN_ALLOWED_ORIGINS=http://localhost:4205,http://localhost:4202,http://localhost:4200,http://localhost:5173
# Domaines vers lesquels un retour après achat est accepté.
IDOMAIN_RETURN_HOSTS=idem.africa,localhost,127.0.0.1
# Destinataires des événements signés (`nom=url`, séparés par des virgules).
IDOMAIN_WEBHOOK_TARGETS=

# PostgreSQL : sa propre base `idomain`, sur le serveur PostgreSQL d'iDeploy. Mot de passe : secret.
IDOMAIN_DB_HOST=localhost
IDOMAIN_DB_PORT=5432
IDOMAIN_DB_DATABASE=idomain
IDOMAIN_DB_USERNAME=idomain
# Pour les migrations (node-pg-migrate lit DATABASE_URL).
DATABASE_URL=postgres://idomain:${IDOMAIN_DB_PASSWORD}@localhost:5432/idomain

# Redis : files BullMQ (préfixe `idomain`).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Domain Name API : bac à sable par défaut (`false` pour la production).
DNA_SANDBOX=true
# Développement seulement : un registrar simulé (refusé en production).
IDOMAIN_SIMULATED_REGISTRAR=false

# ─── Infisical (gestionnaire de secrets) ─────────────────────────────────────
USE_SECRET_MANAGER=false
INFISICAL_SITE_URL=
INFISICAL_ENVIRONMENT=prod
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# ─── Secrets — dans `.env.secret` en local, dans Infisical en production ─────
# IDOMAIN_DB_PASSWORD=
# Même valeur que IDOMAIN_SERVICE_KEY de l'API IDEM (projet Infisical `api`).
# IDOMAIN_SERVICE_KEY=
# Même valeur que IDOMAIN_IDEPLOY_KEY de l'API iDeploy (projet Infisical `ideploy-api`).
# IDOMAIN_IDEPLOY_KEY=
# Clé de la console (API d'idem-admin).
# IDOMAIN_ADMIN_KEY=
# IDOMAIN_WEBHOOK_SECRET=
# DNA_RESELLER_ID=
# DNA_API_KEY=
