# ─── iVision API — configuration (non sensible) ─────────────────────────────
# Copier en `.env`. Les SECRETS vont dans `.env.secret` (même dossier, jamais commité) en local,
# et dans Infisical (projet `ivision-api`) en production : voir src/config/secrets.ts.
PORT=3006
NODE_ENV=development

# L'API IDEM : identité (cookie `session`), passerelle interne (modèles, crédits, chartes).
IDEM_API_URL=http://localhost:3001
# URL publique de CETTE API (sons et médias servis aux pages d'aperçu et de rendu).
IVISION_API_URL=http://localhost:3006
# Origines admises (front iVision, tableau de bord IDEM).
IVISION_ALLOWED_ORIGINS=http://localhost:4204,http://localhost:4200
IDEM_DASHBOARD_URL=http://localhost:4200

# MongoDB : le même cluster qu'IDEM, collections `ivision_*`. ${MONGODB_PASSWORD} vient de .env.secret.
MONGODB_URI=mongodb://admin:${MONGODB_PASSWORD}@localhost:27017/idem?authSource=admin
MONGODB_DATABASE=idem

# MinIO : le même stockage qu'IDEM, préfixe `ivision/`. Les clés sont dans .env.secret.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=idem-storage
MINIO_PUBLIC_URL=http://localhost:9000

# Rendu (Chromium + ffmpeg) : chemins facultatifs, sinon ceux du système.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_RENDER_JOBS=1

# ─── Infisical (gestionnaire de secrets) ─────────────────────────────────────
# false en local (.env.secret suffit) ; true, ou NODE_ENV=production : toutes les variables du
# projet Infisical `ivision-api` sont chargées au démarrage (cf. secret-loader.ts).
USE_SECRET_MANAGER=false
INFISICAL_SITE_URL=
# `prod` en production, `dev` avec l'instance locale.
INFISICAL_ENVIRONMENT=prod
INFISICAL_PROJECT_ID=
# Identité machine d'ivision-api (Universal Auth, lecture seule sur son projet).
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# ─── Secrets — dans `.env.secret` en local, dans Infisical en production ─────
# MONGODB_PASSWORD=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# Même valeur que IVISION_SERVICE_KEY de l'API IDEM (apps/api/.env.secret, projet Infisical `api`).
# IVISION_SERVICE_KEY=
# Facultatifs : banques de médias.
# PEXELS_API_KEY=
# JAMENDO_CLIENT_ID=
