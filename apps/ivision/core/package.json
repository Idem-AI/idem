{
  "name": "@idem/ivision-core",
  "version": "1.0.0",
  "private": true,
  "description": "Moteur créatif partagé d’iVision et d’IDEM : vidéos motion design (Motion Canvas : directeur, planificateur, auteur, rendu serveur) et visuels.",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p motion/tsconfig.json",
    "check": "ts-node --transpile-only scripts/check-core.ts",
    "check:montage": "ts-node --transpile-only scripts/check-montage.ts",
    "check:choices": "ts-node --transpile-only scripts/check-choices.ts",
    "check:request": "ts-node --transpile-only scripts/check-request.ts",
    "check:motion": "ts-node --transpile-only scripts/check-motion.ts",
    "check:hyperframes": "ts-node --transpile-only scripts/check-hyperframes.ts",
    "crawl": "ts-node --transpile-only scripts/crawl-site.ts",
    "check:intent": "ts-node --transpile-only scripts/check-intent.ts",
    "check:lottie": "ts-node --transpile-only scripts/check-lottie.ts",
    "check:demo": "ts-node --transpile-only scripts/check-demo.ts",
    "check:brief": "ts-node --transpile-only scripts/check-brief.ts",
    "lottie:library": "ts-node --transpile-only scripts/build-lottie-library.ts"
  },
  "dependencies": {
    "@adobe/leonardo-contrast-colors": "1.1.0",
    "@capsizecss/metrics": "4.4.0",
    "@hyperframes/lint": "^0.9.13",
    "@hyperframes/producer": "^0.9.13",
    "@idem/graphic-engine": "file:../../../packages/graphic-engine",
    "@lottiefiles/dotlottie-web": "0.80.0",
    "@lume/kiwi": "0.4.4",
    "@material/material-color-utilities": "0.3.0",
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2",
    "@phosphor-icons/core": "^2.1.1",
    "@tabler/icons": "^3.48.0",
    "animejs": "^4.5.0",
    "axios": "^1.7.9",
    "esbuild": "^0.28.1",
    "gsap": "^3.15.1",
    "heroicons": "^2.2.0",
    "hyperframes": "^0.9.13",
    "jszip": "^3.10.1",
    "lucide-static": "^1.52.0",
    "mongoose": "^8.9.3",
    "music-tempo": "1.0.3",
    "pdfjs-dist": "^4.8.69",
    "puppeteer": "24.30.0",
    "sharp": "^0.35.5",
    "smartcrop-sharp": "2.0.8",
    "svgo": "^4.0.0",
    "tailwindcss": "4.1.17",
    "tex-linebreak": "0.9.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
