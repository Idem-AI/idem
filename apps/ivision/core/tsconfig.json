{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "../../../",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@idem/graphic-engine": ["../../../packages/graphic-engine/src"],
      "@idem/design-tools": ["../../../packages/design-tools/src"]
    }
  },
  "include": ["src/**/*"]
}
