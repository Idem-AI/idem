# ═══════════════════════════════════════════════════════════════════════════
# IDEM dashboard — local development
# These values are compiled into the JavaScript bundle served to visitors:
# they are PUBLIC. Never put a secret here (private key, password, token).
# ═══════════════════════════════════════════════════════════════════════════

# ── Firebase (public web identifiers) ───────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=lexis-ia.firebaseapp.com
FIREBASE_PROJECT_ID=lexis-ia
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# ── Services ────────────────────────────────────────────────────────────────
SERVICES_DOMAIN=https://idem.africa
SERVICES_API_URL=http://localhost:3001
SERVICES_IDEPLOY_URL=http://localhost:4202
SERVICES_SIMULATION_URL=http://localhost:4203
SERVICES_WEBGEN_URL=http://localhost:5173
SERVICES_DIAGEN_URL=http://localhost:5174

# ── Misc ────────────────────────────────────────────────────────────────────
WAITLIST_URL=
IS_BETA=true
ANALYTICS_ENABLED=false
