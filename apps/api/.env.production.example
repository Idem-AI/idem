# ═══════════════════════════════════════════════════════════════════════════
# IDEM API — PRODUCTION configuration (container environment)
#
# This file contains NO secrets. Secrets are read at start-up from Infisical
# (project `api`, environment `prod`); the reference list is
# api/config/secrets.manifest.ts. A secret value left here would take
# precedence over Infisical: do not add any.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_URL=https://api.idem.africa
IDEM_FRONTEND_URL=https://console.idem.africa
CORS_ALLOWED_ORIGINS=https://idem.africa,https://console.idem.africa,https://appgen.idem.africa,https://chart.idem.africa,https://simulation.idem.africa,https://ideploy.idem.africa
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb
GLOBAL_RATE_LIMIT_MAX=600
LOG_LEVEL=info
ENABLE_API_DOCS=false

# ── Infisical (secret manager) ──────────────────────────────────────────────
# INFISICAL_PROJECT_ID, INFISICAL_CLIENT_ID and INFISICAL_CLIENT_SECRET (the
# `api` machine identity) go in a separate root-only env file, not here.
USE_SECRET_MANAGER=true
INFISICAL_SITE_URL=https://secrets.idem.africa
INFISICAL_ENVIRONMENT=prod

# ── Authentication (self-hosted Supabase auth server) ───────────────────────
# Internal URL of GoTrue (same Docker network or loopback), no /auth/v1.
# Secrets (Infisical): SUPABASE_JWT_SECRET, SESSION_SECRET.
SUPABASE_AUTH_URL=http://idem-auth:9999

# ── Authorization ───────────────────────────────────────────────────────────
ADMIN_EMAILS=
IS_BETA=false

# ── MongoDB (password from `MONGODB_PASSWORD`, Infisical) ─────────────────────────
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=idem
MONGODB_USERNAME=

# ── Redis (password from `REDIS_PASSWORD`, Infisical) ─────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── MinIO (keys `MINIO_ACCESS_KEY` / `MINIO_SECRET_KEY`, Infisical)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=idem-storage
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=https://storage.idem.africa

# ── iDeploy PostgreSQL database (password: `IDEPLOY_DB_PASSWORD`, Infisical) ──────
IDEPLOY_DB_HOST=postgres
IDEPLOY_DB_PORT=5432
IDEPLOY_DB_DATABASE=
IDEPLOY_DB_USERNAME=

# ── Artificial intelligence ─────────────────────────────────────────────────
GEMINI_BACKEND=vertex
GCP_PROJECT_ID=lexis-ia
GOOGLE_CLOUD_LOCATION=global

# ── Integrations ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_REDIRECT_URI=https://api.idem.africa/github/auth/callback

# ── E-mail (password: `SMTP_PASS`, Infisical) ─────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
EMAIL_FROM=noreply@idem.africa

# ── Quotas and limits ───────────────────────────────────────────────────────
DAILY_QUOTA_LIMIT=50
WEEKLY_QUOTA_LIMIT=200
MIN_INPUT_LENGTH=10
MAX_INPUT_LENGTH=5000
MAX_STYLES=3
MAX_RESOLUTION=1024

# ── pawaPay payments (token: `PAWAPAY_API_TOKEN`, Infisical) ──────────────────────
PAWAPAY_ENV=production
# Switch to `enforce` as soon as signing is enabled on the pawaPay side.
PAWAPAY_CALLBACK_SIGNATURE=log
PAWAPAY_CALLBACK_IPS=
PAWAPAY_PUBLIC_KEY=
PAYMENTS_ENABLED=true

# ── Security ────────────────────────────────────────────────────────────────
RENDER_ALLOWED_HOSTS=
