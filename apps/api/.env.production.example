# ═══════════════════════════════════════════════════════════════════════════
# IDEM API — PRODUCTION configuration (container environment)
#
# This file contains NO secrets. Secrets are read at start-up from Google
# Secret Manager as `api--<VARIABLE>`; the reference list is
# api/config/secrets.manifest.ts. A secret value left here would take
# precedence over Secret Manager: do not add any.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_URL=https://api.idem.africa
IDEM_FRONTEND_URL=https://console.idem.africa
CORS_ALLOWED_ORIGINS=https://idem.africa,https://console.idem.africa,https://appgen.idem.africa,https://chart.idem.africa,https://simulation.idem.africa,https://ideploy.idem.africa
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb
GLOBAL_RATE_LIMIT_MAX=600
LOG_LEVEL=info
ENABLE_API_DOCS=false

# ── Secret Manager ──────────────────────────────────────────────────────────
USE_SECRET_MANAGER=true
GCP_PROJECT_ID=lexis-ia
SECRET_ENV_PREFIX=
# JSON key of the API service account (access limited to `api--*` secrets).
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/idem-sa.json

# ── Authentication (self-hosted Supabase auth server) ───────────────────────
# Internal URL of GoTrue (same Docker network or loopback), no /auth/v1.
# Secrets: api--SUPABASE_JWT_SECRET, api--SESSION_SECRET.
SUPABASE_AUTH_URL=http://idem-auth:9999

# ── Authorization ───────────────────────────────────────────────────────────
ADMIN_EMAILS=
IS_BETA=false

# ── MongoDB (password from `api--MONGODB_PASSWORD`) ─────────────────────────
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=idem
MONGODB_USERNAME=

# ── Redis (password from `api--REDIS_PASSWORD`) ─────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── MinIO (keys from `api--MINIO_ACCESS_KEY` / `api--MINIO_SECRET_KEY`)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=idem-storage
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=https://storage.idem.africa

# ── iDeploy PostgreSQL database (password: `api--IDEPLOY_DB_PASSWORD`) ──────
IDEPLOY_DB_HOST=postgres
IDEPLOY_DB_PORT=5432
IDEPLOY_DB_DATABASE=
IDEPLOY_DB_USERNAME=

# ── Artificial intelligence ─────────────────────────────────────────────────
GEMINI_BACKEND=vertex
GOOGLE_CLOUD_LOCATION=global

# ── Integrations ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_REDIRECT_URI=https://api.idem.africa/github/auth/callback

# ── E-mail (password: `api--SMTP_PASS`) ─────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
EMAIL_FROM=noreply@idem.africa

# ── Quotas and limits ───────────────────────────────────────────────────────
DAILY_QUOTA_LIMIT=50
WEEKLY_QUOTA_LIMIT=200
MIN_INPUT_LENGTH=10
MAX_INPUT_LENGTH=5000
MAX_STYLES=3
MAX_RESOLUTION=1024

# ── pawaPay payments (token: `api--PAWAPAY_API_TOKEN`) ──────────────────────
PAWAPAY_ENV=production
# Switch to `enforce` as soon as signing is enabled on the pawaPay side.
PAWAPAY_CALLBACK_SIGNATURE=log
PAWAPAY_CALLBACK_IPS=
PAWAPAY_PUBLIC_KEY=
PAYMENTS_ENABLED=true

# ── Security ────────────────────────────────────────────────────────────────
RENDER_ALLOWED_HOSTS=
