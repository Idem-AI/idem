# ═══════════════════════════════════════════════════════════════════════════
# API IDEM — configuration de PRODUCTION (environnement du conteneur)
#
# Ce fichier ne contient AUCUN secret. Les secrets sont lus au démarrage dans
# Google Secret Manager sous le nom `api--<VARIABLE>` ; la liste fait foi dans
# api/config/secrets.manifest.ts. Une valeur secrète laissée ici prendrait le
# pas sur Secret Manager : ne pas en ajouter.
# ═══════════════════════════════════════════════════════════════════════════

# ── Serveur ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_URL=https://api.idem.africa
IDEM_FRONTEND_URL=https://console.idem.africa
CORS_ALLOWED_ORIGINS=https://idem.africa,https://console.idem.africa,https://appgen.idem.africa,https://chart.idem.africa,https://simulation.idem.africa,https://ideploy.idem.africa
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb
GLOBAL_RATE_LIMIT_MAX=600
LOG_LEVEL=info
ENABLE_API_DOCS=false

# ── Secret Manager ──────────────────────────────────────────────────────────
USE_SECRET_MANAGER=true
GCP_PROJECT_ID=lexis-ia
SECRET_ENV_PREFIX=
# Clé JSON du compte de service de l'API (accès limité aux secrets `api--*`).
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/idem-sa.json

# ── Firebase — identifiants publics ─────────────────────────────────────────
FIREBASE_PROJECT_ID=lexis-ia
FIREBASE_API_KEY=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=

# ── Autorisations ───────────────────────────────────────────────────────────
ADMIN_EMAILS=
IS_BETA=false

# ── MongoDB (le mot de passe vient de `api--MONGODB_PASSWORD`) ──────────────
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=idem
MONGODB_USERNAME=

# ── Redis (le mot de passe vient de `api--REDIS_PASSWORD`) ──────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── MinIO (les clés viennent de `api--MINIO_ACCESS_KEY` / `api--MINIO_SECRET_KEY`)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=idem-storage
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=https://storage.idem.africa

# ── Base PostgreSQL d'iDeploy (mot de passe : `api--IDEPLOY_DB_PASSWORD`) ────
IDEPLOY_DB_HOST=postgres
IDEPLOY_DB_PORT=5432
IDEPLOY_DB_DATABASE=
IDEPLOY_DB_USERNAME=

# ── Intelligence artificielle ───────────────────────────────────────────────
GEMINI_BACKEND=vertex
GOOGLE_CLOUD_LOCATION=global

# ── Intégrations ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_REDIRECT_URI=https://api.idem.africa/github/auth/callback

# ── E-mail (mot de passe : `api--SMTP_PASS`) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
EMAIL_FROM=noreply@idem.africa

# ── Quotas et limites ───────────────────────────────────────────────────────
DAILY_QUOTA_LIMIT=50
WEEKLY_QUOTA_LIMIT=200
MIN_INPUT_LENGTH=10
MAX_INPUT_LENGTH=5000
MAX_STYLES=3
MAX_RESOLUTION=1024

# ── Paiements pawaPay (jeton : `api--PAWAPAY_API_TOKEN`) ────────────────────
PAWAPAY_ENV=production
# Passer à `enforce` dès que la signature est activée côté pawaPay.
PAWAPAY_CALLBACK_SIGNATURE=log
PAWAPAY_CALLBACK_IPS=
PAWAPAY_PUBLIC_KEY=
PAYMENTS_ENABLED=true

# ── Sécurité ────────────────────────────────────────────────────────────────
RENDER_ALLOWED_HOSTS=
