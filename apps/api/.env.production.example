# Production Environment Configuration Example
# Copy this file to .env.production and update with your production values

# Firebase Configuration (Auth only)
FIREBASE_AUTH_DOMAIN="lexis-ia.firebaseapp.com"
FIREBASE_PROJECT_ID="lexis-ia"
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_APP_ID="1:78825247320:web:12c2eaa97dfaf1d5f3f02d"
FIREBASE_MEASUREMENT_ID="G-1YQGTP97EJ"
# FIREBASE_PRIVATE_KEY_ID → Secret Manager : api--FIREBASE_PRIVATE_KEY_ID
# FIREBASE_PRIVATE_KEY → Secret Manager : api--FIREBASE_PRIVATE_KEY
# FIREBASE_CLIENT_EMAIL → Secret Manager : api--FIREBASE_CLIENT_EMAIL
FIREBASE_CLIENT_ID="your-production-client-id"
AUT_URI="https://accounts.google.com/o/oauth2/auth"
TOKEN_URI="https://oauth2.googleapis.com/token"

# MongoDB Configuration
MONGODB_URI=mongodb://username:password@your-mongodb-host:27017/idem?authSource=admin

# MinIO Configuration (S3-compatible object storage)
# For production with MinIO deployed on a custom domain
MINIO_ENDPOINT=storage.idem.africa
MINIO_PORT=443
MINIO_USE_SSL=true
# MINIO_ACCESS_KEY → Secret Manager : api--MINIO_ACCESS_KEY
# MINIO_SECRET_KEY → Secret Manager : api--MINIO_SECRET_KEY
MINIO_BUCKET_NAME=idem-storage
# Public URL for MinIO (IMPORTANT: This is what clients will use to access files)
# This should be your MinIO domain with HTTPS
MINIO_PUBLIC_URL=https://storage.idem.africa

# CORS Configuration
CORS_ALLOWED_ORIGINS="https://idem.africa,https://dashboard.idem.africa,https://api.idem.africa"

# Redis Configuration
REDIS_HOST="your-redis-host"
REDIS_PORT="6379"
# REDIS_PASSWORD → Secret Manager : api--REDIS_PASSWORD
REDIS_DB="Idem"

# Google AI Configuration
# GEMINI_API_KEY → Secret Manager : api--GEMINI_API_KEY
# DEEPSEEK_API_KEY → Secret Manager : api--DEEPSEEK_API_KEY
# OPENAI_API_KEY → Secret Manager : api--OPENAI_API_KEY

# Stock Image APIs (for Communication feature)
# PEXELS_API_KEY → Secret Manager : api--PEXELS_API_KEY

# GitHub Integration
GITHUB_CLIENT_ID=your-production-github-client-id
# GITHUB_CLIENT_SECRET → Secret Manager : api--GITHUB_CLIENT_SECRET
GITHUB_REDIRECT_URI=https://api.idem.africa/api/github/auth/callback

# Beta Configuration
IS_BETA=false
BETA_DAILY_QUOTA_LIMIT=100
BETA_WEEKLY_QUOTA_LIMIT=500
BETA_MAX_STYLES=5
BETA_MAX_RESOLUTION=2048
BETA_ALLOWED_FEATURES=branding,business-plan,diagrams,deployment
BETA_MAX_OUTPUT_TOKENS=8000
MIN_INPUT_LENGTH=10
MAX_INPUT_LENGTH=10000

# Server Configuration
PORT=3001
NODE_ENV=production

# Authorization System
ADMIN_EMAILS=admin@idem.africa
APP_URL=https://idem.africa

# Email Service Configuration
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your-production-email-api-key
EMAIL_FROM=noreply@idem.africa

# SMTP Configuration for Contact Form
SMTP_HOST=smtp.privateemail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@idem.africa
# SMTP_PASS → Secret Manager : api--SMTP_PASS

# Security Keys
# SENSITIVE_VARS_ENCRYPTION_KEY → Secret Manager : api--SENSITIVE_VARS_ENCRYPTION_KEY

# Inter-Service Authentication
# INTERNAL_API_KEY → Secret Manager : api--INTERNAL_API_KEY

# iDeploy SSO shared secret (must match IDEPLOY_SHARED_SECRET in iDeploy .env)
# IDEPLOY_SHARED_SECRET → Secret Manager : api--IDEPLOY_SHARED_SECRET

# ── Encaissement Mobile Money (pawaPay) ───────────────────────────────────
# Le jeton vit dans Google Secret Manager, sous `api--PAWAPAY_API_TOKEN` —
# jamais dans ce fichier. Ne restent ici que les
# réglages non sensibles.
# production : URL de base ET liste blanche d'IP de production. Absent, le
# client retombe sur le bac à sable.
PAWAPAY_ENV=production
# Signature des callbacks : enforce | log | off.
PAWAPAY_CALLBACK_SIGNATURE=log
# Liste blanche d'IP surchargée (virgules). Vide = liste officielle pawaPay.
PAWAPAY_CALLBACK_IPS=
# Arrêt d'urgence indépendant de MongoDB et du panel admin.
PAYMENTS_ENABLED=true
