# ═══════════════════════════════════════════════════════════════════════════
# API IDEM — configuration de DÉVELOPPEMENT LOCAL
#
# Copier en `.env`. Les secrets (bloc final) peuvent aller dans `.env.secret`,
# chargé automatiquement après `.env` ; aucun des deux n'est jamais commité.
# Production : voir `.env.production.example` — les secrets y sont lus dans
# Google Secret Manager (`api--<VARIABLE>`), jamais dans un fichier.
# ═══════════════════════════════════════════════════════════════════════════

# ── Serveur ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# URL publique de l'API (liens signés des visuels, callbacks).
API_URL=http://localhost:3001
# URL du dashboard (liens dans les e-mails).
IDEM_FRONTEND_URL=http://localhost:4200
# Origines autorisées, séparées par des virgules (localhost est accepté hors production).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb
GLOBAL_RATE_LIMIT_MAX=600
LOG_LEVEL=info
# Swagger sur /api-docs (toujours actif hors production).
ENABLE_API_DOCS=false

# ── Firebase (authentification) — identifiants publics ──────────────────────
FIREBASE_PROJECT_ID=lexis-ia
FIREBASE_API_KEY=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=

# ── Autorisations ───────────────────────────────────────────────────────────
# Super users, séparés par des virgules (adresse vérifiée exigée).
ADMIN_EMAILS=admin@example.com
IS_BETA=false

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Soit une URI complète, soit les champs séparés (le mot de passe est un secret).
MONGODB_URI=
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=idem
MONGODB_USERNAME=admin

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379   (prioritaire sur les champs ci-dessus)

# ── MinIO (stockage objet) ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=idem-storage
MINIO_REGION=us-east-1
# URL publique des fichiers (domaine personnalisé en production).
MINIO_PUBLIC_URL=http://localhost:9000

# ── Base PostgreSQL d'iDeploy ───────────────────────────────────────────────
IDEPLOY_DB_HOST=localhost
IDEPLOY_DB_PORT=5432
IDEPLOY_DB_DATABASE=ideploy
IDEPLOY_DB_USERNAME=ideploy

# ── Intelligence artificielle ───────────────────────────────────────────────
# Gemini : `vertex` (facturation Google Cloud, compte de service Firebase) ou
# `ai-studio` (clé GEMINI_API_KEY).
GEMINI_BACKEND=vertex
GOOGLE_CLOUD_LOCATION=global
GLM_API_URL=
DEEPSEEK_API_URL=

# ── Intégrations ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_REDIRECT_URI=http://localhost:3001/github/auth/callback

# ── E-mail (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
EMAIL_FROM=noreply@idem.africa

# ── Quotas et limites ───────────────────────────────────────────────────────
DAILY_QUOTA_LIMIT=50
WEEKLY_QUOTA_LIMIT=200
MIN_INPUT_LENGTH=10
MAX_INPUT_LENGTH=5000
MAX_STYLES=3
MAX_RESOLUTION=1024

# ── Paiements (pawaPay) ─────────────────────────────────────────────────────
# sandbox | production
PAWAPAY_ENV=sandbox
# Vérification des signatures de callback : enforce | log | off.
PAWAPAY_CALLBACK_SIGNATURE=log
# Liste blanche d'IP (virgules). Vide = liste officielle pawaPay.
PAWAPAY_CALLBACK_IPS=
# Clé publique de vérification (facultatif : récupérée chez pawaPay sinon).
PAWAPAY_PUBLIC_KEY=
# Arrêt d'urgence : `false` = aucun paiement initié.
PAYMENTS_ENABLED=true
# Fichier de tarification (défaut : packages/shared-models/src/pricing/pricing.config.json).
# PRICING_CONFIG_PATH=

# ── Sécurité ────────────────────────────────────────────────────────────────
# Hôtes internes supplémentaires que les rendus PDF/visuels peuvent charger
# (MINIO_PUBLIC_URL, MINIO_ENDPOINT et API_URL le sont déjà).
RENDER_ALLOWED_HOSTS=

# ── Google Secret Manager ───────────────────────────────────────────────────
# `false` en local : les secrets viennent du bloc ci-dessous ou de `.env.secret`.
USE_SECRET_MANAGER=false
GCP_PROJECT_ID=lexis-ia
SECRET_ENV_PREFIX=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Réglages avancés (facultatifs, valeurs par défaut dans le code) ─────────
# Modèles : AI_DEFAULT_PROVIDER, AI_DEFAULT_MODEL, AI_OVERRIDES, AI_PRICING_OVERRIDES,
#   IDEM_GEMINI_WRITING_MODEL, IDEM_GEMINI_REASONING_MODEL, IDEM_GEMINI_MECHANICAL_MODEL,
#   IDEM_GEMINI_VISION_MODEL, IDEM_GEMINI_OCR_MODEL, IDEM_GEMINI_IMAGE_MODEL,
#   IDEM_GEMINI_MOCKUP_MODELS, IDEM_MEDIA_PROVIDER, IDEM_MOCKUP_PROVIDER, IDEM_LLM_URL
# Débit et temps : IDEM_GEMINI_CONCURRENCY, IDEM_GLM_CONCURRENCY, IDEM_MAX_PARALLEL_STEPS,
#   LLM_TIMEOUT_MS, LLM_RATE_LIMIT_DELAY_MS, LLM_JSON_MODE, GLM_CACHED_INPUT_RATIO
# Génération : IDEM_SECTION_PLAN, IDEM_SECTION_TEMPLATE, IDEM_TEMPLATE_OUTPUT_TOKENS,
#   IDEM_PLAN_MIN_BLOCKS, IDEM_RESEARCH_CACHE_TTL, COHERENCE_CHECKS_ENABLED, RESTRICTED_PROMPTS
# Divers : AI_USAGE_TTL_DAYS, XAF_USD_RATE, IDEM_DISABLE_FETCH_DIAGNOSTICS

# ═══════════════════════════════════════════════════════════════════════════
# SECRETS — local uniquement (ici ou dans `.env.secret`).
# Production : Secret Manager, `api--<VARIABLE>` (liste : api/config/secrets.manifest.ts).
# ═══════════════════════════════════════════════════════════════════════════
# Requis
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
MONGODB_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
INTERNAL_API_KEY=
# 32 octets aléatoires, ex. `openssl rand -base64 32`. Chiffre des données en base.
SENSITIVE_VARS_ENCRYPTION_KEY=
# Optionnels
FIREBASE_PRIVATE_KEY_ID=
REDIS_PASSWORD=
GEMINI_API_KEY=
GLM_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GITHUB_CLIENT_SECRET=
PEXELS_API_KEY=
GOOGLE_FONTS_API_KEY=
SMTP_PASS=
PAWAPAY_API_TOKEN=
IDEPLOY_SHARED_SECRET=
JWT_SECRET=
GITHUB_STATE_SECRET=
METRICS_TOKEN=
IDEPLOY_DB_PASSWORD=
