# ═══════════════════════════════════════════════════════════════════════════
# IDEM API — LOCAL DEVELOPMENT configuration
#
# Copy to `.env`. Secrets (last block) can go in `.env.secret`, loaded
# automatically after `.env`; neither is ever committed.
# Production: see `.env.production.example` — secrets are read from Infisical
# (project `api`), never from a file.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Public URL of the API (signed visual links, callbacks).
API_URL=http://localhost:3001
# Dashboard URL (links in e-mails).
IDEM_FRONTEND_URL=http://localhost:4200
# Allowed origins, comma-separated (localhost is accepted outside production).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4204
JSON_BODY_LIMIT=10mb
URLENCODED_BODY_LIMIT=10mb
GLOBAL_RATE_LIMIT_MAX=600
LOG_LEVEL=info
# Swagger on /api-docs (always on outside production).
ENABLE_API_DOCS=false

# ── Authentication (self-hosted Supabase auth server, infra/supabase-auth) ──
# Root URL of GoTrue as seen from the API (no /auth/v1).
SUPABASE_AUTH_URL=http://localhost:9999

# ── Authorization ───────────────────────────────────────────────────────────
# Super users, comma-separated (verified address required).
ADMIN_EMAILS=admin@example.com
IS_BETA=false

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Either a full URI or the separate fields (the password is a secret).
MONGODB_URI=
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=idem
MONGODB_USERNAME=admin

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379   (takes precedence over the fields above)

# ── MinIO (object storage) ──────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=idem-storage
MINIO_REGION=us-east-1
# Public URL of the files (custom domain in production).
MINIO_PUBLIC_URL=http://localhost:9000

# ── iDeploy PostgreSQL database ─────────────────────────────────────────────
IDEPLOY_DB_HOST=localhost
IDEPLOY_DB_PORT=5432
IDEPLOY_DB_DATABASE=ideploy
IDEPLOY_DB_USERNAME=ideploy

# ── Artificial intelligence ─────────────────────────────────────────────────
# Gemini: `vertex` (Google Cloud billing, GCP_SA_* service account) or
# `ai-studio` (GEMINI_API_KEY).
GEMINI_BACKEND=vertex
GCP_PROJECT_ID=lexis-ia
GOOGLE_CLOUD_LOCATION=global
GLM_API_URL=
DEEPSEEK_API_URL=

# ── Integrations ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_REDIRECT_URI=http://localhost:3001/github/auth/callback

# ── E-mail (SMTP) ───────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
EMAIL_FROM=noreply@idem.africa

# ── Quotas and limits ───────────────────────────────────────────────────────
DAILY_QUOTA_LIMIT=50
WEEKLY_QUOTA_LIMIT=200
MIN_INPUT_LENGTH=10
MAX_INPUT_LENGTH=5000
MAX_STYLES=3
MAX_RESOLUTION=1024

# ── Payments (pawaPay) ──────────────────────────────────────────────────────
# sandbox | production
PAWAPAY_ENV=sandbox
# Callback signature check: enforce | log | off.
PAWAPAY_CALLBACK_SIGNATURE=log
# IP allow-list (comma-separated). Empty = official pawaPay list.
PAWAPAY_CALLBACK_IPS=
# Verification public key (optional: fetched from pawaPay otherwise).
PAWAPAY_PUBLIC_KEY=
# Kill switch: `false` = no payment is initiated.
PAYMENTS_ENABLED=true
# Pricing file (default: packages/shared-models/src/pricing/pricing.config.json).
# PRICING_CONFIG_PATH=

# ── Security ────────────────────────────────────────────────────────────────
# Extra internal hosts that PDF/visual rendering may load
# (MINIO_PUBLIC_URL, MINIO_ENDPOINT and API_URL already are).
RENDER_ALLOWED_HOSTS=

# ── Infisical (secret manager) ──────────────────────────────────────────────
# `false` locally: secrets come from the block below or from `.env.secret`.
USE_SECRET_MANAGER=false
INFISICAL_SITE_URL=
# Environment slug: `prod` in production, `dev` with the local instance.
INFISICAL_ENVIRONMENT=prod
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# ── Advanced settings (optional, defaults in code) ──────────────────────────
# Models: AI_DEFAULT_PROVIDER, AI_DEFAULT_MODEL, AI_OVERRIDES, AI_PRICING_OVERRIDES,
#   IDEM_GEMINI_WRITING_MODEL, IDEM_GEMINI_REASONING_MODEL, IDEM_GEMINI_MECHANICAL_MODEL,
#   IDEM_GEMINI_VISION_MODEL, IDEM_GEMINI_OCR_MODEL, IDEM_GEMINI_IMAGE_MODEL,
#   IDEM_GEMINI_MOCKUP_MODELS, IDEM_MEDIA_PROVIDER, IDEM_MOCKUP_PROVIDER, IDEM_LLM_URL
# Throughput and timing: IDEM_GEMINI_CONCURRENCY, IDEM_GLM_CONCURRENCY, IDEM_MAX_PARALLEL_STEPS,
#   LLM_TIMEOUT_MS, LLM_RATE_LIMIT_DELAY_MS, LLM_JSON_MODE, GLM_CACHED_INPUT_RATIO
# Generation: IDEM_SECTION_PLAN, IDEM_SECTION_TEMPLATE, IDEM_TEMPLATE_OUTPUT_TOKENS,
#   IDEM_PLAN_MIN_BLOCKS, IDEM_RESEARCH_CACHE_TTL, COHERENCE_CHECKS_ENABLED, RESTRICTED_PROMPTS
# Misc: AI_USAGE_TTL_DAYS, XAF_USD_RATE, IDEM_DISABLE_FETCH_DIAGNOSTICS

# ═══════════════════════════════════════════════════════════════════════════
# SECRETS — local only (here or in `.env.secret`).
# Production: Infisical, project `api` (list: api/config/secrets.manifest.ts).
# ═══════════════════════════════════════════════════════════════════════════
# Required
# Google Cloud service account for Vertex AI (project: GCP_PROJECT_ID).
GCP_SA_PRIVATE_KEY=
GCP_SA_CLIENT_EMAIL=
# Shared with the auth server (its AUTH_JWT_SECRET), ≥ 32 characters.
SUPABASE_JWT_SECRET=
# Signs the `session` cookie, ≥ 32 characters (openssl rand -hex 32).
SESSION_SECRET=
MONGODB_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
INTERNAL_API_KEY=
# 32 random bytes, e.g. `openssl rand -base64 32`. Encrypts data at rest.
SENSITIVE_VARS_ENCRYPTION_KEY=
# Optional
REDIS_PASSWORD=
GEMINI_API_KEY=
GLM_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GITHUB_CLIENT_SECRET=
PEXELS_API_KEY=
GOOGLE_FONTS_API_KEY=
SMTP_PASS=
PAWAPAY_API_TOKEN=
IDEPLOY_SHARED_SECRET=
# Clé de la passerelle d'iVision (/internal/ivision), même valeur dans ivision-api.
IVISION_SERVICE_KEY=
JWT_SECRET=
GITHUB_STATE_SECRET=
METRICS_TOKEN=
IDEPLOY_DB_PASSWORD=
