{
  "name": "idem-api",
  "version": "1.0.0",
  "description": "API for idem Architecture and Diagram Generator",
  "main": "index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "check:agents": "ts-node --transpile-only api/scripts/checkAgentPipeline.ts",
    "check:design": "ts-node --transpile-only api/scripts/checkDesignSystem.ts",
    "check:graphic": "npm --prefix ../../packages/graphic-engine run check",
    "check:fonts": "ts-node --transpile-only api/scripts/checkFonts.ts",
    "check:retry": "ts-node --transpile-only api/scripts/verifyRetry.ts",
    "dev": "nodemon api/index.ts",
    "build": "tsc",
    "build:mermaid": "ts-node --transpile-only api/scripts/buildMermaid.ts",
    "start": "ts-node api/index.ts",
    "vercel-build": "tsc",
    "secrets:purge-history": "bash scripts/purge-env-from-history.sh",
    "check:uniqueness": "ts-node --transpile-only api/scripts/checkUniqueness.ts",
    "check:roles": "ts-node --transpile-only api/scripts/checkCreativeRoles.ts",
    "check:assets": "ts-node --transpile-only api/scripts/checkAssetRegistry.ts",
    "check:all": "npm run check:agents && npm run check:design && npm run check:graphic && npm run check:fonts && npm run check:uniqueness && npm run check:brand && npm run check:simreport && npm run check:bpquality && npm run check:prompts && npm run check:openrouter && npm run check:jurisdictions && npm run check:salvage && npm run check:mockups && npm run check:comm && npm run check:inputs && npm run check:logo && npm run check:assets && npm run check:roles && npm run check:video:intent && npm run check:relayout && npm run check:quotas",
    "og:render": "ts-node --transpile-only api/scripts/renderOgImages.ts",
    "check:brand": "ts-node --transpile-only api/scripts/checkBrandSync.ts",
    "check:simreport": "ts-node --transpile-only api/scripts/checkSimulationReport.ts",
    "check:bpquality": "ts-node --transpile-only api/scripts/checkBusinessPlanQuality.ts",
    "check:prompts": "ts-node --transpile-only api/scripts/checkPromptConformity.ts",
    "check:jurisdictions": "ts-node --transpile-only api/scripts/checkJurisdictions.ts",
    "check:salvage": "ts-node --transpile-only api/scripts/checkHtmlSalvage.ts",
    "check:mockups": "ts-node --transpile-only api/scripts/checkSocialMockups.ts",
    "check:billing": "ts-node --transpile-only api/scripts/checkBilling.ts",
    "check:payments": "ts-node --transpile-only api/scripts/checkPayments.ts",
    "check:payments:sandbox": "ts-node --transpile-only api/scripts/checkPaymentsSandbox.ts",
    "grant:welcome": "ts-node --transpile-only api/scripts/grantWelcomeCredit.ts",
    "auth:import": "ts-node --transpile-only api/scripts/importAuthAccounts.ts",
    "check:openrouter": "ts-node --transpile-only api/scripts/checkOpenRouter.ts",
    "ai:matrix": "ts-node --transpile-only api/scripts/printAiModels.ts",
    "ai:models": "ts-node --transpile-only api/scripts/setAiModels.ts",
    "openrouter:matrix": "ts-node --transpile-only api/scripts/openrouterMatrix.ts",
    "check:indexes": "ts-node --transpile-only api/scripts/checkIndexes.ts",
    "check:video": "ts-node --transpile-only ../ivision/core/scripts/check-motion.ts",
    "check:comm": "ts-node --transpile-only api/scripts/checkCommunicationPlans.ts",
    "check:inputs": "ts-node --transpile-only api/scripts/checkProjectInputs.ts",
    "check:auth": "ts-node --transpile-only api/scripts/checkAuthFlow.ts",
    "check:creativity": "ts-node --transpile-only api/scripts/checkCreativity.ts",
    "check:video:intent": "ts-node --transpile-only api/scripts/checkVideoIntent.ts",
    "check:ivision": "ts-node --transpile-only api/scripts/checkIvisionGateway.ts",
    "check:logo": "ts-node --transpile-only -P tsconfig.json api/scripts/checkLogoEngine.ts",
    "check:quotas": "ts-node --transpile-only -P tsconfig.json api/scripts/checkQuotas.ts",
    "quotas:matrix": "ts-node --transpile-only -P tsconfig.json api/scripts/printQuotas.ts",
    "db:drop-legacy-quota": "ts-node --transpile-only -P tsconfig.json api/scripts/dropLegacyQuota.ts",
    "check:offer": "ts-node --transpile-only -P tsconfig.json api/scripts/checkOfferModel.ts",
    "billing:migrate-offer": "ts-node --transpile-only -P tsconfig.json api/scripts/migrateOfferModel.ts",
    "docs:logo": "ts-node --transpile-only -P tsconfig.json api/scripts/docsLogoGenerators.ts",
    "check:relayout": "ts-node --transpile-only api/scripts/checkRelayout.ts"
  },
  "author": "arolleaguekeng",
  "license": "MIT",
  "dependencies": {
    "@idem/graphic-engine": "^1.0.0",
    "@idem/shared-models": "^1.0.0",
    "@infisical/sdk": "^5.0.2",
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2",
    "@octokit/rest": "^21.1.1",
    "@phosphor-icons/core": "^2.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tabler/icons": "^3.48.0",
    "ag-psd": "^28.3.1",
    "axios": "^1.7.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "file-type": "^16.5.4",
    "fs-extra": "^11.0.4",
    "helmet": "^8.1.0",
    "heroicons": "^2.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.1",
    "jszip": "^3.10.1",
    "lucide-static": "^1.52.0",
    "minio": "^8.0.2",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.10",
    "openai": "^4.95.1",
    "opentype.js": "^2.0.0",
    "paper": "^0.12.18",
    "pdfjs-dist": "^4.8.69",
    "pg": "^8.13.3",
    "potrace": "^2.1.8",
    "pptxgenjs": "4.0.1",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.17.0",
    "sharp": "^0.35.5",
    "svgo": "^4.0.0",
    "svgson": "^5.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "4.1.17",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/hpp": "^0.2.7",
    "@types/ioredis": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.11",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.11.11",
    "@types/svgo": "^2.6.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
