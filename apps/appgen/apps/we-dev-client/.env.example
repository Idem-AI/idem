# ═══════════════════════════════════════════════════════════════════════════
# Client AppGen (we-dev-client)
#
# SEULES les variables préfixées `REACT_APP_` entrent dans le bundle, et ce
# bundle est PUBLIC : n'y mettez jamais de secret. Tout le reste est ignoré.
# ═══════════════════════════════════════════════════════════════════════════

# Serveur AppGen (we-dev-next).
REACT_APP_BASE_URL=http://localhost:3000
REACT_APP_NEXT_API_BASE_URL=http://localhost:3000
# API IDEM.
REACT_APP_IDEM_API_BASE_URL=http://localhost:3001
# Dashboard IDEM (connexion).
REACT_APP_IDEM_MAIN_APP_URL=http://localhost:4200
# iDeploy (bouton de déploiement).
REACT_APP_IDEPLOY_URL=http://localhost:4202
