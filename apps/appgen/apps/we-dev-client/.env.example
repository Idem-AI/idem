# ═══════════════════════════════════════════════════════════════════════════
# AppGen client (we-dev-client)
#
# ONLY variables prefixed with `REACT_APP_` reach the bundle, and that bundle
# is PUBLIC: never put a secret here. Everything else is ignored.
# ═══════════════════════════════════════════════════════════════════════════

# AppGen server (we-dev-next).
REACT_APP_BASE_URL=http://localhost:3000
REACT_APP_NEXT_API_BASE_URL=http://localhost:3000
# IDEM API.
REACT_APP_IDEM_API_BASE_URL=http://localhost:3001
# IDEM dashboard (sign-in).
REACT_APP_IDEM_MAIN_APP_URL=http://localhost:4200
# iDeploy (deploy button).
REACT_APP_IDEPLOY_URL=http://localhost:4202
