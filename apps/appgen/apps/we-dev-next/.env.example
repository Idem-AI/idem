# ═══════════════════════════════════════════════════════════════════════════
# Serveur AppGen (we-dev-next) — configuration
#
# Local : copier en `.env` et remplir aussi le bloc SECRETS en fin de fichier.
# Production : USE_SECRET_MANAGER=true ; les secrets sont lus dans Google
# Secret Manager sous `appgen--<VARIABLE>` (liste : src/config/secrets.manifest.ts)
# et le bloc SECRETS reste VIDE — une valeur ici prendrait le pas sur Secret Manager.
# ═══════════════════════════════════════════════════════════════════════════

# ── Serveur ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Origines autorisées avec le cookie de session IDEM (OBLIGATOIRE en production,
# séparées par des virgules ; localhost est accepté hors production).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origines autorisées sur le point MCP /mcp.
MCP_ALLOWED_ORIGINS=

# ── API IDEM (sessions et facturation) ──────────────────────────────────────
IDEM_API_URL=http://localhost:3001

# ── Modèles ─────────────────────────────────────────────────────────────────
GLM_API_URL=https://api.z.ai/api/paas/v4
# Fournisseur des modèles sans clé propre (API compatible OpenAI).
THIRD_API_URL=

# ── Déploiement Netlify ─────────────────────────────────────────────────────
NETLIFY_DEPLOY_URL=https://api.netlify.com/api/v1/sites

# ── Assets (import des images en http dans l'aperçu) ────────────────────────
MINIO_PUBLIC_URL=http://localhost:9000
ASSET_BASE_URL=
# Hôtes supplémentaires autorisés (virgules).
ASSET_INLINE_ALLOWED_HOSTS=

# ── Google Secret Manager ───────────────────────────────────────────────────
USE_SECRET_MANAGER=false
GCP_PROJECT_ID=lexis-ia
SECRET_ENV_PREFIX=
# Production : clé JSON du compte de service d'AppGen (accès limité à `appgen--*`).
GOOGLE_APPLICATION_CREDENTIALS=

# ── Réglages avancés (facultatifs, valeurs par défaut dans le code) ─────────
# AI_MAX_RETRIES, PLAN_MAX_TOOL_STEPS, SKILLS_CONTEXTUAL_BUDGET, SKILLS_MAX_CONTEXTUAL, DEBUG_PROMPTS

# ═══════════════════════════════════════════════════════════════════════════
# SECRETS — local uniquement. Production : Secret Manager, `appgen--<VARIABLE>`.
# ═══════════════════════════════════════════════════════════════════════════
GLM_API_KEY=
THIRD_API_KEY=
NETLIFY_TOKEN=
# Marquage des sites Netlify par propriétaire (défaut : NETLIFY_TOKEN).
DEPLOY_OWNER_SECRET=
SCREENSHOTONE_API_KEY=
