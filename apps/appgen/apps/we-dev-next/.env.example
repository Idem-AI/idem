# ═══════════════════════════════════════════════════════════════════════════
# AppGen server (we-dev-next) — configuration
#
# Local: copy to `.env` and also fill the SECRETS block at the end.
# Production: USE_SECRET_MANAGER=true; secrets are read from Infisical
# (project `appgen`, list: src/config/secrets.manifest.ts)
# and the SECRETS block stays EMPTY — a value here would override Infisical.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Origins allowed with the IDEM session cookie (REQUIRED in production,
# comma-separated; localhost is accepted outside production).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origins allowed on the /mcp endpoint.
MCP_ALLOWED_ORIGINS=

# ── IDEM API (sessions and billing) ─────────────────────────────────────────
IDEM_API_URL=http://localhost:3001

# ── Models ──────────────────────────────────────────────────────────────────
# OpenRouter is the only model provider (can later point to a self-hosted vLLM/SGLang).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Starting default model (a catalogue key); changeable live: POST /api/model/default.
APPGEN_DEFAULT_MODEL=qwen/qwen3-coder-next

# ── Netlify deployment ──────────────────────────────────────────────────────
NETLIFY_DEPLOY_URL=https://api.netlify.com/api/v1/sites

# ── Assets (inlining http images in the preview) ────────────────────────────
MINIO_PUBLIC_URL=http://localhost:9000
ASSET_BASE_URL=
# Extra allowed hosts (comma-separated).
ASSET_INLINE_ALLOWED_HOSTS=

# ── Infisical (secret manager) ──────────────────────────────────────────────
USE_SECRET_MANAGER=false
INFISICAL_SITE_URL=
# Environment slug: `prod` in production, `dev` with the local instance.
INFISICAL_ENVIRONMENT=prod
INFISICAL_PROJECT_ID=
# Machine identity of appgen (Universal Auth, read-only on its project).
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# ── Advanced settings (optional, defaults in code) ──────────────────────────
# AI_MAX_RETRIES, PLAN_MAX_TOOL_STEPS, SKILLS_CONTEXTUAL_BUDGET, SKILLS_MAX_CONTEXTUAL, DEBUG_PROMPTS

# ═══════════════════════════════════════════════════════════════════════════
# SECRETS — local only. Production: Infisical, project `appgen`.
# ═══════════════════════════════════════════════════════════════════════════
OPENROUTER_API_KEY=
# Key of POST /api/model/default (x-admin-key header). Empty = route closed.
MODEL_ADMIN_KEY=
NETLIFY_TOKEN=
# Owner tagging of Netlify sites (default: NETLIFY_TOKEN).
DEPLOY_OWNER_SECRET=
SCREENSHOTONE_API_KEY=

# iDeploy API (mise en ligne depuis iCode). Prod : https://ideploy-api.idem.africa
IDEPLOY_API_URL=http://localhost:3002
