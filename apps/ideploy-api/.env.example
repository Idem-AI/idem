# ═══════════════════════════════════════════════════════════════════════════
# ideploy-api — configuration
#
# Local: copy to `.env` and also fill the SECRETS block at the end.
# Production: USE_SECRET_MANAGER=true; secrets are read from Infisical
# (project `ideploy-api`, list: api/config/secrets.manifest.ts)
# and the SECRETS block stays EMPTY — a value here would override Infisical.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:4202
IDEPLOY_API_PUBLIC_URL=http://localhost:3002
IDEPLOY_WEB_URL=http://localhost:4202

# ── Authentication (delegated to the IDEM API: `session` cookie) ────────────
IDEM_API_URL=http://localhost:3001

# ── PostgreSQL (schema inherited from the former Laravel iDeploy) ───────────
IDEPLOY_DB_HOST=localhost
IDEPLOY_DB_PORT=5432
IDEPLOY_DB_DATABASE=ideploy
IDEPLOY_DB_USERNAME=ideploy

# ── Redis (job queues + cache) ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Realtime (Soketi / Pusher protocol) ─────────────────────────────────────
PUSHER_APP_ID=ideploy
PUSHER_APP_KEY=ideploy
PUSHER_HOST=localhost
PUSHER_PORT=6001
PUSHER_SCHEME=http

# ── GitHub / GitLab OAuth ───────────────────────────────────────────────────
# In production, keep these in the Infisical project with their secrets: every
# variable of the project is loaded. Set them here for local development only.
# Callbacks : {IDEPLOY_API_PUBLIC_URL}/api/v1/github/auth/callback
#             {IDEPLOY_API_PUBLIC_URL}/api/v1/gitlab/auth/callback (scopes read_user, read_api, read_repository)
GITHUB_CLIENT_ID=
GITLAB_CLIENT_ID=
# Only for a self-hosted GitLab instance.
GITLAB_INSTANCE_URL=https://gitlab.com

# ── IDEM-managed servers ────────────────────────────────────────────────────
IDEM_DEFAULT_REGION=DE

# ── Infisical (secret manager) ──────────────────────────────────────────────
USE_SECRET_MANAGER=false
INFISICAL_SITE_URL=
# Environment slug: `prod` in production, `dev` with the local instance.
INFISICAL_ENVIRONMENT=prod
INFISICAL_PROJECT_ID=
# Machine identity of ideploy-api (Universal Auth, read-only on its project).
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# ── Advanced settings (optional, defaults in code) ──────────────────────────
# SSH : SSH_COMMAND_TIMEOUT, SSH_MAX_RETRIES, SSH_RETRY_BASE_DELAY, SSH_RETRY_MAX_DELAY,
#   SSH_RETRY_MULTIPLIER, SSH_MUX_ENABLED, SSH_MUX_PERSIST_TIME, IDEPLOY_SSH_DIR
# Data: IDEPLOY_DATA_DIR, IDEPLOY_TEMPLATES_PATH, IDEPLOY_VERSION, IDEPLOY_AUTO_UPDATE
# Scheduled tasks: SERVER_HEALTH_CRON, FIREWALL_PURGE_CRON,
#   FIREWALL_TRAFFIC_RETENTION_DAYS, FIREWALL_ALERT_RETENTION_DAYS
# Firewall / proxy: CROWDSEC_LAPI_URL, CROWDSEC_BOUNCER_LOG_LEVEL, TRAEFIK_BOUNCER_VERSION,
#   TRAEFIK_GEOBLOCK_VERSION, TRAEFIK_GEOBLOCK_API, TRAEFIK_GEOBLOCK_CACHE_SIZE,
#   TRAEFIK_GEOBLOCK_CACHE_TTL, TRAEFIK_GEOBLOCK_TIMEOUT_MS
# Prisma introspection (`npm run prisma:pull`, dev tool only, never in production):
#   DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>?schema=public

# ═══════════════════════════════════════════════════════════════════════════
# SECRETS — local only. Production: Infisical, project `ideploy-api`.
# ═══════════════════════════════════════════════════════════════════════════
# Required
IDEPLOY_DB_PASSWORD=
# Laravel key (`base64:…` format): encrypts SSH keys and credentials at rest.
APP_KEY=
# Optional
REDIS_PASSWORD=
PUSHER_APP_SECRET=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
NAMECHEAP_API_KEY=

# ── Adresses idem.africa pour ce qui est publié depuis iCode ─────────────────
# monapp.idem.africa (ou monapp-<id> si le nom est pris) : enregistrement A créé
# chez Namecheap, vers l'IP du serveur de l'application. Laisser vide = adresse
# automatique (sslip.io), comme avant.
# ⚠️ L'API Namecheap réécrit TOUTE la zone à chaque écriture : iDeploy relit la
# zone, ajoute l'enregistrement et la renvoie entière (verrou Redis, contrôle
# après écriture). NAMECHEAP_CLIENT_IP = IP publique du serveur de l'API iDeploy,
# à ajouter dans la liste blanche de l'API Namecheap (Profile → Tools → API Access).
IDEPLOY_PLATFORM_DOMAIN=
NAMECHEAP_API_USER=
# NAMECHEAP_API_KEY : c'est un secret, voir le bloc SECRETS ci-dessus.
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX=false
