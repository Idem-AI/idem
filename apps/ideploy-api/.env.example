# ═══════════════════════════════════════════════════════════════════════════
# ideploy-api — configuration
#
# Local : copier en `.env` et remplir aussi le bloc SECRETS en fin de fichier.
# Production : USE_SECRET_MANAGER=true ; les secrets sont lus dans Google
# Secret Manager sous `ideploy-api--<VARIABLE>` (liste : api/config/secrets.manifest.ts)
# et le bloc SECRETS reste VIDE — une valeur ici prendrait le pas sur Secret Manager.
# ═══════════════════════════════════════════════════════════════════════════

# ── Serveur ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:4202
IDEPLOY_API_PUBLIC_URL=http://localhost:3002
IDEPLOY_WEB_URL=http://localhost:4202

# ── Authentification (déléguée à l'API IDEM : cookie `session`) ─────────────
IDEM_API_URL=http://localhost:3001

# ── PostgreSQL (schéma partagé avec l'ancien iDeploy Laravel) ───────────────
IDEPLOY_DB_HOST=localhost
IDEPLOY_DB_PORT=5432
IDEPLOY_DB_DATABASE=ideploy
IDEPLOY_DB_USERNAME=ideploy

# ── Redis (files de tâches + cache) ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Temps réel (Soketi / protocole Pusher) ──────────────────────────────────
PUSHER_APP_ID=ideploy
PUSHER_APP_KEY=ideploy
PUSHER_HOST=localhost
PUSHER_PORT=6001
PUSHER_SCHEME=http

# ── OAuth GitHub / GitLab — identifiants publics ────────────────────────────
# Callbacks : {IDEPLOY_API_PUBLIC_URL}/api/v1/github/auth/callback
#             {IDEPLOY_API_PUBLIC_URL}/api/v1/gitlab/auth/callback (scopes read_user, read_api, read_repository)
GITHUB_CLIENT_ID=
GITLAB_CLIENT_ID=
# Seulement pour une instance GitLab auto-hébergée.
GITLAB_INSTANCE_URL=https://gitlab.com

# ── Serveurs gérés par IDEM ─────────────────────────────────────────────────
IDEM_DEFAULT_REGION=DE

# ── Google Secret Manager ───────────────────────────────────────────────────
USE_SECRET_MANAGER=false
GCP_PROJECT_ID=lexis-ia
SECRET_ENV_PREFIX=
# Production : clé JSON du compte de service d'ideploy-api (accès limité à `ideploy-api--*`).
GOOGLE_APPLICATION_CREDENTIALS=

# ── Réglages avancés (facultatifs, valeurs par défaut dans le code) ─────────
# SSH : SSH_COMMAND_TIMEOUT, SSH_MAX_RETRIES, SSH_RETRY_BASE_DELAY, SSH_RETRY_MAX_DELAY,
#   SSH_RETRY_MULTIPLIER, SSH_MUX_ENABLED, SSH_MUX_PERSIST_TIME, IDEPLOY_SSH_DIR
# Données : IDEPLOY_DATA_DIR, IDEPLOY_TEMPLATES_PATH, IDEPLOY_VERSION, IDEPLOY_AUTO_UPDATE
# Tâches planifiées : SERVER_HEALTH_CRON, FIREWALL_PURGE_CRON,
#   FIREWALL_TRAFFIC_RETENTION_DAYS, FIREWALL_ALERT_RETENTION_DAYS
# Pare-feu / proxy : CROWDSEC_LAPI_URL, CROWDSEC_BOUNCER_LOG_LEVEL, TRAEFIK_BOUNCER_VERSION,
#   TRAEFIK_GEOBLOCK_VERSION, TRAEFIK_GEOBLOCK_API, TRAEFIK_GEOBLOCK_CACHE_SIZE,
#   TRAEFIK_GEOBLOCK_CACHE_TTL, TRAEFIK_GEOBLOCK_TIMEOUT_MS
# Introspection Prisma (`npm run prisma:pull`, outil de dev uniquement, jamais en production) :
#   DATABASE_URL=postgresql://<user>:<mot de passe>@localhost:5432/<base>?schema=public

# ═══════════════════════════════════════════════════════════════════════════
# SECRETS — local uniquement. Production : Secret Manager, `ideploy-api--<VARIABLE>`.
# ═══════════════════════════════════════════════════════════════════════════
# Requis
IDEPLOY_DB_PASSWORD=
# Clé Laravel (format `base64:…`) : chiffre les clés SSH et identifiants en base.
APP_KEY=
# Optionnels
REDIS_PASSWORD=
PUSHER_APP_SECRET=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
