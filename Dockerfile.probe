FROM node:24-alpine AS builder
WORKDIR /app

# 1. Copier les manifestes à la racine
COPY package.json package-lock.json tsconfig.base.json ./

# 2. Copier les packages partagés (simulation ne consomme que shared-styles,
#    qui est du CSS pur — pas de build TS nécessaire)
COPY ./packages/shared-styles ./packages/shared-styles

COPY ./packages/shared-tour ./packages/shared-tour
COPY ./packages/shared-promotions ./packages/shared-promotions
COPY ./packages/shared-trusted-by  ./packages/shared-trusted-by 
COPY ./packages/shared-loader  ./packages/shared-loader 
# Service worker partagé. Simulation le consomme AUSSI par le lien
# `apps/simulation/src/app/shared/shared-offline` (Angular 22, voir
# preserveSymlinks) : ce lien pointe ici, le dossier doit donc exister.
COPY ./packages/shared-offline ./packages/shared-offline
# 3. Copier l'application
COPY ./apps/simulation ./apps/simulation

# 4. Copier le .env
RUN touch ./apps/simulation/.env
# 5. Installer toutes les dépendances depuis la racine
RUN npm install --legacy-peer-deps --ignore-scripts

# 6. Aller dans l'app
WORKDIR /app/apps/simulation

# 7. Générer environment.ts
RUN NODE_ENV=production node mynode.js

# 8. Builder Angular

RUN ls -l /app/packages/shared-offline/scripts/sync.mjs && echo PRESENT
