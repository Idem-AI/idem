# Build arguments for environment-specific builds
ARG BUILD_ENV=production

# Dockerfile.landing
FROM node:20-alpine AS builder
WORKDIR /app

# Copier les fichiers de configuration racine
COPY package.json package-lock.json tsconfig.base.json ./

# Copier les packages partagés (dépendances)
COPY ./packages/shared-models ./packages/shared-models
COPY ./packages/shared-auth-client ./packages/shared-auth-client
COPY ./packages/shared-styles ./packages/shared-styles
COPY ./packages/shared-loader ./packages/shared-loader
COPY ./packages/shared-trusted-by ./packages/shared-trusted-by
COPY ./packages/shared-seo ./packages/shared-seo
# Promotions (prix barrés, bandeau de campagne).
COPY ./packages/shared-promotions ./packages/shared-promotions
# Service worker partagé : recopié dans `public/` par le prebuild.
COPY ./packages/shared-offline ./packages/shared-offline

# Copier l'application landing
COPY ./apps/landing ./apps/landing
RUN touch ./apps/landing/.env
# Installer les dépendances globales sans scripts
RUN npm install dotenv 
RUN npm install --legacy-peer-deps --ignore-scripts

# Installer les dépendances de l'application landing
WORKDIR /app/apps/landing

# --- Génération de l'environnement (src/environments/environment.ts) ---

# RUN test -f .env || (echo " .env introuvable dans /app/apps/landing — vérifie .dockerignore" && exit 1)
RUN npm run env:prod

# --- Builds ---

# Builder l'application landing (version anglaise d'abord)

RUN ls -l /app/packages/shared-offline/scripts/sync.mjs && echo PRESENT
