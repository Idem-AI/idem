{
  "name": "@idem/shared-loader",
  "version": "1.0.0",
  "description": "L'unique indicateur de chargement d'Idem : un seul semis, partagé par toutes les applications et rendu pour chaque framework (Angular, React, Svelte), pour que l'attente se présente partout de la même façon",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./angular": "./src/angular/index.ts",
    "./react": "./src/react/index.ts",
    "./svelte": "./src/svelte/index.ts",
    "./loader.css": "./src/loader.css"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "idem",
    "loader",
    "spinner",
    "shared"
  ],
  "author": "Idem Team",
  "license": "MIT",
  "peerDependencies": {
    "@angular/core": ">=20",
    "react": ">=18",
    "svelte": ">=5"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
