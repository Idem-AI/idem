{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "documentType": {
      "type": "string",
      "enum": [
        "business-plan",
        "pitch-deck",
        "brand-charter",
        "business-card",
        "flyer",
        "chart",
        "report"
      ]
    },
    "format": {
      "type": "string",
      "enum": [
        "a4-portrait",
        "slide-16x9",
        "page-a4",
        "page-a4-landscape",
        "card-landscape",
        "card-portrait",
        "flyer-square",
        "flyer-story",
        "flyer-banner",
        "flyer-post",
        "flyer-a4",
        "cover-facebook",
        "cover-linkedin",
        "cover-x",
        "cover-youtube",
        "avatar-square",
        "chart-free"
      ]
    },
    "creativity": {
      "$ref": "#/$defs/__schema0"
    },
    "bible": {
      "type": "string",
      "maxLength": 2400
    },
    "tokensHash": {
      "type": "string",
      "maxLength": 32
    },
    "seed": {
      "type": "string",
      "maxLength": 120
    },
    "engine": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 16
        },
        "components": {
          "type": "string",
          "maxLength": 16
        }
      },
      "required": [
        "version",
        "components"
      ],
      "additionalProperties": false
    },
    "sections": {
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 2
          },
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
          },
          "pattern": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 48
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "html": {
            "type": "string",
            "maxLength": 400000
          },
          "bible": {
            "type": "string",
            "maxLength": 2400
          },
          "level": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "version",
          "ref",
          "pattern",
          "html"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "documentType",
    "format",
    "creativity",
    "tokensHash",
    "seed",
    "engine",
    "sections"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "ultra"
      ]
    }
  },
  "title": "IDEM — DesignSpec",
  "$comment": "Version 2.0 — généré depuis src/contracts (zod). Ne pas modifier à la main."
}
