# Dockerfile.dev for the iDeploy API service (Node + Express + TS)
# Development version with hot-reload.
#
# Includes openssh-client + bash + curl because the deployment engine shells
# out to `ssh`/`scp` (multiplexed) and runs the Docker CLI on remote servers.
#
# docker-cli (+ the docker-cli-compose plugin) is for the "local server" path
# specifically (ssh/target.ts's isLocalServer): a server whose ip is
# 127.0.0.1/localhost/host.docker.internal runs `docker`/`git`/`docker compose`
# directly in *this* container instead of over SSH — so the CLI has to exist
# here too. It talks to the host's own daemon via the docker.sock bind mount in
# docker-compose.dev.yml, not a nested daemon. Without docker-cli-compose
# specifically, `docker` itself works (readiness's Docker Engine check passes)
# but `docker compose ...` fails on every one of them — the plugin is a
# separate package from the base CLI, not bundled with it.

FROM node:20-alpine

RUN apk add --no-cache dumb-init openssh-client bash curl docker-cli docker-cli-compose git

WORKDIR /app

# Workspace manifests
COPY package.json package-lock.json tsconfig.base.json ./

# Shared packages
COPY ./packages ./packages

# iDeploy API source
COPY ./apps/ideploy-api ./apps/ideploy-api

# Install all workspaces from root to establish symlinks
RUN npm install --legacy-peer-deps

WORKDIR /app/apps/ideploy-api

# Generate the Prisma client (empty until `prisma db pull` is run against the DB)
RUN npx prisma generate || true

EXPOSE 3002

CMD ["npm", "run", "dev"]
