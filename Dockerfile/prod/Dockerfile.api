# Build arguments for environment-specific builds
ARG BUILD_ENV=production

FROM node:20-alpine AS builder

# Install security updates and build dependencies
RUN apk update && apk upgrade && \
    apk add --no-cache dumb-init && \
    rm -rf /var/cache/apk/*

WORKDIR /app

# Copy package files first for better layer caching
COPY package.json package-lock.json tsconfig.base.json ./

# Copy packages partagés
COPY ./packages/shared-models ./packages/shared-models
COPY ./packages/shared-auth-client ./packages/shared-auth-client
COPY ./packages/shared-styles ./packages/shared-styles
# Le moteur de génération graphique (business plan, charte, pitch deck, cartes, visuels, graphiques).
COPY ./packages/graphic-engine ./packages/graphic-engine

# Build shared-models first
WORKDIR /app/packages/shared-models
RUN npm install --legacy-peer-deps && npm run build && npm cache clean --force

# Return to /app before copying API
WORKDIR /app

# Copy API application
COPY ./apps/api ./apps/api

# Le moteur créatif partagé avec iVision (vidéos, visuels, scan de site) : compilé avec l'API
# (imports relatifs). Son dossier `motion/` (runtime Motion Canvas) est compilé à la demande avec chaque film.
COPY ./apps/ivision/core ./apps/ivision/core

# Prepare directory structure
WORKDIR /app/apps/api

# Install dependencies
RUN npm install --legacy-peer-deps --force && npm cache clean --force

# Install missing dependencies manually at root level
WORKDIR /app
RUN npm install fs-extra --legacy-peer-deps --save

# Return to API directory
WORKDIR /app/apps/api

# Manually add shared-models
RUN mkdir -p node_modules/@idem && \
    cp -r /app/packages/shared-models ./node_modules/@idem/shared-models

# Build application
RUN npm run build

# @idem/graphic-engine est un paquet « à la volée » : ses sources TypeScript sont compilées AVEC l'API
# (dist/packages/graphic-engine/src). Node le résout ensuite par son nom : la copie compilée remplace
# le lien du workspace, et ses dépendances se trouvent dans /app/node_modules.
RUN rm -rf /app/node_modules/@idem/graphic-engine && mkdir -p /app/node_modules/@idem/graphic-engine \
    && cp -r dist/packages/graphic-engine/src/. /app/node_modules/@idem/graphic-engine/ \
    && node -e "require('fs').writeFileSync('/app/node_modules/@idem/graphic-engine/package.json', JSON.stringify({ name: '@idem/graphic-engine', version: '1.0.0', main: 'index.js' }))"

# Production stage
FROM node:20-alpine AS production
ARG BUILD_ENV

# Install security updates and runtime dependencies
RUN apk update && apk upgrade && \
    apk add --no-cache \
    dumb-init \
    chromium \
    nss \
    freetype \
    freetype-dev \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    # Vidéos motion design : encodage H.264/AAC et analyse du tempo des musiques.
    ffmpeg \
    && rm -rf /var/cache/apk/*

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S apiuser -u 1001

WORKDIR /app

# Set Puppeteer environment variables
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV NODE_ENV=${BUILD_ENV:-production}

# Copy built application and dependencies
COPY --from=builder --chown=apiuser:nodejs /app/apps/api/package*.json ./
COPY --from=builder --chown=apiuser:nodejs /app/apps/api/dist ./dist
COPY --from=builder --chown=apiuser:nodejs /app/apps/api/public ./public
# Les sources du runtime vidéo (kit, harnais, lecteur, exemples) : esbuild les compile avec chaque film.
COPY --from=builder --chown=apiuser:nodejs /app/apps/ivision/core/motion ./dist/apps/ivision/core/motion

# Copy node_modules from root (npm installs them there in monorepo)
COPY --from=builder --chown=apiuser:nodejs /app/node_modules ./node_modules

# Also copy shared packages that might be needed
COPY --from=builder --chown=apiuser:nodejs /app/packages ./packages

# Create logs directory with correct permissions
RUN mkdir -p /app/logs && chown -R apiuser:nodejs /app/logs

# Switch to non-root user
USER apiuser

CMD ["node", "dist/apps/api/api/index.js"]
