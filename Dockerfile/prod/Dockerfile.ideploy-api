# Build arguments for environment-specific builds
ARG BUILD_ENV=production

FROM node:20-alpine AS builder

WORKDIR /app

# Workspace manifests
COPY package.json package-lock.json tsconfig.base.json ./

# Shared packages
COPY ./packages ./packages

# iDeploy API source
COPY ./apps/ideploy-api ./apps/ideploy-api

# Install all workspaces from root to establish symlinks
RUN npm install --legacy-peer-deps

WORKDIR /app/apps/ideploy-api

# Generate the Prisma client (schema-only — no DB reachable at build time)
RUN npx prisma generate

# Compile TypeScript (tsconfig.json: outDir ./dist, rootDir inferred as api/)
RUN npm run build

# Production stage
FROM node:20-alpine AS production
ARG BUILD_ENV

# openssh-client/bash/curl/docker-cli/git: the deployment engine shells out to
# ssh/scp and to the Docker CLI on remote servers, and runs `docker`/`git`
# directly for the "local server" case (see Dockerfile/dev/Dockerfile.ideploy-api
# for the full explanation — same runtime needs apply in production).
RUN apk update && apk upgrade && \
    apk add --no-cache \
    dumb-init \
    openssh-client \
    bash \
    curl \
    docker-cli \
    docker-cli-compose \
    git \
    ca-certificates \
    && rm -rf /var/cache/apk/*

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S ideployapi -u 1001

WORKDIR /app

ENV NODE_ENV=${BUILD_ENV:-production}

# Copy the compiled app and its own package.json — needed both for `npm run
# migrate:*` operational scripts on the server, and because CMD itself now
# starts the app via `npm run start:provisioned`, not a bare `node ...`.
COPY --from=builder --chown=ideployapi:nodejs /app/apps/ideploy-api/package*.json ./
COPY --from=builder --chown=ideployapi:nodejs /app/apps/ideploy-api/dist ./dist
COPY --from=builder --chown=ideployapi:nodejs /app/apps/ideploy-api/prisma ./prisma
COPY --from=builder --chown=ideployapi:nodejs /app/apps/ideploy-api/migrations ./migrations
COPY --from=builder --chown=ideployapi:nodejs /app/apps/ideploy-api/templates ./templates

# Automatic DB provisioning (see scripts/provision-db.js's own doc comment):
# a fresh database has no Laravel around anymore to have created the base
# schema, so the CMD below bootstraps it from this snapshot before every
# server start — a no-op once the schema already exists.
COPY --from=builder --chown=ideployapi:nodejs /app/apps/ideploy-api/scripts/provision-db.js ./scripts/provision-db.js
COPY --from=builder --chown=ideployapi:nodejs /app/apps/ideploy-api/scripts/start-provisioned.sh ./scripts/start-provisioned.sh
COPY --from=builder --chown=ideployapi:nodejs /app/apps/ideploy-api/tests/schema.sql ./tests/schema.sql

# node_modules mostly land at the workspace root in this monorepo's npm
# install, but hoisting isn't guaranteed for every package — verified live:
# zod and uuid (both real runtime dependencies, not dev-only) ended up
# nested under apps/ideploy-api/node_modules instead, and a production
# container crashed on startup with "Cannot find module 'zod'" because only
# the root node_modules was ever copied here. Merging the nested one on top
# catches anything hoisting left behind, whichever packages that turns out
# to be — not just these two.
COPY --from=builder --chown=ideployapi:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=ideployapi:nodejs /app/apps/ideploy-api/node_modules/. ./node_modules/
COPY --from=builder --chown=ideployapi:nodejs /app/packages ./packages

RUN mkdir -p /app/logs && chown -R ideployapi:nodejs /app/logs

USER ideployapi

EXPOSE 3002

CMD ["npm", "run", "start:provisioned"]
