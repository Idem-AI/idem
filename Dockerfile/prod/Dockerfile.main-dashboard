FROM node:20-alpine AS builder
WORKDIR /app

# 1. Copier les manifestes à la racine
COPY package.json package-lock.json tsconfig.base.json ./

# 2. Copier les packages partagés
COPY ./packages/shared-models ./packages/shared-models
COPY ./packages/shared-auth-client ./packages/shared-auth-client
COPY ./packages/shared-styles ./packages/shared-styles
COPY ./packages/shared-tour ./packages/shared-tour
COPY ./packages/shared-loader  ./packages/shared-loader
COPY ./packages/shared-video-editor ./packages/shared-video-editor
COPY ./packages/shared-document-editor ./packages/shared-document-editor
COPY ./packages/shared-journey ./packages/shared-journey
COPY ./packages/shared-promotions ./packages/shared-promotions

# 3. Copier l'application
COPY ./apps/main-dashboard ./apps/main-dashboard

# 4. Copier le .env
COPY .env ./apps/main-dashboard/.env

# 5. Installer toutes les dépendances depuis la racine
RUN npm install --legacy-peer-deps --ignore-scripts

# 6. Nettoyer les caches de build
RUN rm -rf packages/shared-models/dist packages/shared-models/tsconfig.tsbuildinfo \
           packages/shared-auth-client/dist packages/shared-auth-client/tsconfig.tsbuildinfo

# 7. Builder shared-models
RUN cd packages/shared-models && npx tsc --build

# 8. Builder shared-auth-client en ignorant les erreurs Svelte (pas utilisé par main-dashboard)
#    Note: --noEmitOnError est incompatible avec --build, on utilise tsc direct
RUN cd packages/shared-auth-client && npx tsc --noEmitOnError false || true

# 9. shared-styles n'a pas de build TS (CSS/SCSS only), rien à compiler

# 10. Aller dans l'app
WORKDIR /app/apps/main-dashboard

# 11. Générer environment.ts
RUN NODE_ENV=production node mynode.js

# 12. Builder Angular
RUN npm run build

# --- Stage de production ---
FROM alpine:3.22 AS production

# nginx du paquet Alpine (et non l'image officielle) : c'est le seul moyen
# d'avoir le module Brotli, absent de `nginx:alpine`. `brotli` et `zopfli`
# servent à précompresser les fichiers au build.
RUN apk add --no-cache nginx nginx-mod-http-brotli brotli zopfli && \
    mkdir -p /usr/share/nginx/html /var/log/nginx && \
    ln -sf /dev/stdout /var/log/nginx/access.log && \
    ln -sf /dev/stderr /var/log/nginx/error.log

COPY /apps/main-dashboard/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/apps/main-dashboard/dist/main-dashboard/browser /usr/share/nginx/html

# Conversion WebP des images, à côté des originaux (`photo.png` ->
# `photo.png.webp`). nginx sert la version WebP aux navigateurs qui
# l'acceptent (voir la carte `$idem_webp`), l'original aux autres : aucune
# référence à changer dans les gabarits. Gain typique : 70 % sur un PNG.
#
# `-q 82` : au-delà, le gain de qualité ne se voit plus et le poids remonte.
# `-metadata none` retire les blocs EXIF, souvent plus lourds que l'image.
RUN apk add --no-cache libwebp-tools && \
    find /usr/share/nginx/html -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) \
      -size +10k \
      -exec sh -c 'cwebp -quiet -q 82 -metadata none "$1" -o "$1.webp" || rm -f "$1.webp"' _ {} \; && \
    apk del libwebp-tools

# Précompression au build : Brotli qualité 11 et gzip Zopfli, servis par
# `brotli_static` / `gzip_static`. Les deux compressent nettement mieux que la
# compression à la volée et ne coûtent aucun CPU à chaque requête. Sur un lien
# à bas débit, c'est 16 % de temps d'attente en moins sur tout le JS et le HTML.
RUN find /usr/share/nginx/html -type f \
      \( -name '*.js' -o -name '*.mjs' -o -name '*.css' -o -name '*.html' \
         -o -name '*.json' -o -name '*.svg' -o -name '*.xml' -o -name '*.txt' \
         -o -name '*.webmanifest' -o -name '*.wasm' \) \
      -size +256c \
      -exec brotli -q 11 -k -f {} \; \
      -exec zopfli --i5 {} \; && \
    nginx -t

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
