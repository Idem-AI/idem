FROM node:24-alpine AS builder
WORKDIR /app

# 1. Copier les manifestes à la racine
COPY package.json package-lock.json tsconfig.base.json ./

# 2. Copier les packages partagés (simulation ne consomme que shared-styles,
#    qui est du CSS pur — pas de build TS nécessaire)
COPY ./packages/shared-styles ./packages/shared-styles

COPY ./packages/shared-tour ./packages/shared-tour

# 3. Copier l'application
COPY ./apps/simulation ./apps/simulation

# 4. Copier le .env
COPY .env ./apps/simulation/.env

# 5. Installer toutes les dépendances depuis la racine
RUN npm install --legacy-peer-deps --ignore-scripts

# 6. Aller dans l'app
WORKDIR /app/apps/simulation

# 7. Générer environment.ts
RUN NODE_ENV=production node mynode.js

# 8. Builder Angular
RUN npm run build

# --- Stage de production ---
FROM nginx:alpine AS production

COPY /apps/simulation/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/apps/simulation/dist/simulation/browser /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
