# Dockerfile.appgen-client
# Build AppGen Client (Vite + React + Tailwind v4)
#
# Deux étapes : le `.env` racine (qui contient les secrets de TOUTES les
# applications) n'existe que dans l'étape de build. L'image finale, poussée sur
# le registre, ne contient que le résultat du build — plus aucun secret.

FROM node:20.18-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@8.15.4

# Copy package.json from the client app
COPY ./apps/appgen/apps/we-dev-client/package.json ./

# Copy shared packages
COPY ./packages/shared-styles /packages/shared-styles
COPY ./packages/shared-tour  ./packages/shared-tour
COPY ./packages/shared-trusted-by ./packages/shared-trusted-by
# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Add autoprefixer (missing in package.json)
RUN pnpm add -D autoprefixer

# Copy all application files
COPY ./apps/appgen/apps/we-dev-client/ ./

# Seules les variables REACT_APP_* sont injectées dans le bundle (vite.config.ts).
# Le .env ne vit que dans l'étape `builder`, qui n'est jamais poussée : l'étape
# `production` ci-dessous n'en recopie rien.
COPY .env .env
RUN pnpm build

FROM node:20.18-alpine AS production

WORKDIR /app
RUN npm install -g pnpm@8.15.4

COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/vite.config.ts ./
COPY --from=builder /app/dist ./dist
COPY --from=builder /packages/shared-styles /packages/shared-styles

# Environment variables
ENV NODE_ENV=production
ENV PORT=4173
ENV HOST=0.0.0.0

USER node

# Expose port
EXPOSE 4173

# Start the application
CMD ["pnpm", "start"]
