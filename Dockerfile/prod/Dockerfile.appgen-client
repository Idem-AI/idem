# Dockerfile.appgen-client
# Build AppGen Client (Vite + React + Tailwind v4)
#
# Deux étapes : le `.env` racine (qui contient les secrets de TOUTES les
# applications) n'existe que dans l'étape de build. L'image finale, poussée sur
# le registre, ne contient que le résultat du build — plus aucun secret.

FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@8.15.4

# Copy package.json from the client app
COPY ./apps/appgen/apps/we-dev-client/package.json ./

# Copy shared packages
COPY ./packages/shared-styles /packages/shared-styles
# `file:../../../../packages/shared-loader` se résout vers /packages depuis /app.
COPY ./packages/shared-loader /packages/shared-loader
COPY ./packages/shared-tour  ./packages/shared-tour
COPY ./packages/shared-trusted-by ./packages/shared-trusted-by
# Pied de page partagé : son alias `../../../../packages/shared-footer` vise /app/packages.
COPY ./packages/shared-footer ./packages/shared-footer
# Source unique de la marque et du référencement : le pied de page y lit la
# définition d'IDEM, il n'en garde pas de copie.
COPY ./packages/shared-seo ./packages/shared-seo
# La boucle IDEM (carte « prochaine étape ») : l'alias `../../../../packages/shared-journey` vise /packages.
COPY ./packages/shared-journey /packages/shared-journey
# Promotions (prix barrés de la page Tarifs) : même alias, vise /packages.
COPY ./packages/shared-promotions /packages/shared-promotions
# Achat et branchement de nom de domaine : l'alias `../../../../packages/shared-idomain` vise /packages.
COPY ./packages/shared-idomain /packages/shared-idomain
# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Add autoprefixer (missing in package.json)
RUN pnpm add -D autoprefixer

# Copy all application files
COPY ./apps/appgen/apps/we-dev-client/ ./

# Seules les variables REACT_APP_* sont injectées dans le bundle (vite.config.ts).
# Le .env ne vit que dans l'étape `builder`, qui n'est jamais poussée : l'étape
# `production` ci-dessous n'en recopie rien.
COPY .env .env
RUN pnpm build

FROM nginx:1.27-alpine AS production

RUN apk add --no-cache gzip && \
    mkdir -p /var/log/nginx && \
    ln -sf /dev/stdout /var/log/nginx/access.log && \
    ln -sf /dev/stderr /var/log/nginx/error.log

COPY ./apps/appgen/apps/we-dev-client/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

# Précompression gzip des assets statiques (servis par gzip_static).
RUN find /usr/share/nginx/html -type f \
      \( -name '*.js' -o -name '*.mjs' -o -name '*.css' -o -name '*.html' \
         -o -name '*.json' -o -name '*.svg' -o -name '*.wasm' \) \
      -size +1024c \
      -exec sh -c 'gzip -9 -k -f "$1"' _ {} \;

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
