# Build arguments for environment-specific builds
ARG BUILD_ENV=production

FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY ./packages ./packages
COPY ./apps/ideploy-web ./apps/ideploy-web

RUN npm install --legacy-peer-deps

WORKDIR /app/apps/ideploy-web

# Generates src/environments/environment.prod.ts from the server's own .env
# (same spot apps/landing's Dockerfile copies its .env for mynode.js to
# read) — that whole environments/ directory is gitignored (see
# scripts/set-env.js), so there is no committed file for `ng build`'s
# production fileReplacements to pick up without this. A value missing here
# fails the build loudly instead of silently shipping a build that talks to
# the wrong backend.
COPY .env .env

RUN npm run build

# Production stage with nginx
FROM nginx:alpine AS production
ARG BUILD_ENV

RUN apk update && apk upgrade && \
    apk add --no-cache dumb-init && \
    rm -rf /var/cache/apk/*

RUN addgroup -g 1001 -S nginx-user && \
    adduser -S nginx-user -u 1001 -G nginx-user

ENV NODE_ENV=${BUILD_ENV:-production}

COPY ./apps/ideploy-web/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/apps/ideploy-web/dist/ideploy-web/browser /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
