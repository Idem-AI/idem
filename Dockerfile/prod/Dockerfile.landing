# Build arguments for environment-specific builds
ARG BUILD_ENV=production

# Dockerfile.landing
FROM node:20-alpine AS builder
WORKDIR /app

# Copier les fichiers de configuration racine
COPY package.json package-lock.json tsconfig.base.json ./

# Copier les packages partagés (dépendances)
COPY ./packages/shared-models ./packages/shared-models
COPY ./packages/shared-auth-client ./packages/shared-auth-client
COPY ./packages/shared-styles ./packages/shared-styles
COPY ./packages/shared-loader ./packages/shared-loader
COPY ./packages/shared-trusted-by ./packages/shared-trusted-by
COPY ./packages/shared-seo ./packages/shared-seo
# Pied de page partagé (colonnes, textes, registre des textes juridiques).
COPY ./packages/shared-footer ./packages/shared-footer
# Promotions (prix barrés, bandeau de campagne).
COPY ./packages/shared-promotions ./packages/shared-promotions
# Service worker partagé : recopié dans `public/` par le prebuild.
COPY ./packages/shared-offline ./packages/shared-offline

# Copier l'application landing
COPY ./apps/landing ./apps/landing
COPY .env ./apps/landing/.env

# Installer les dépendances globales sans scripts
RUN npm install dotenv 
RUN npm install --legacy-peer-deps --ignore-scripts

# Installer les dépendances de l'application landing
WORKDIR /app/apps/landing

# --- Génération de l'environnement (src/environments/environment.ts) ---

# RUN test -f .env || (echo " .env introuvable dans /app/apps/landing — vérifie .dockerignore" && exit 1)
RUN npm run env:prod

# --- Builds ---

# Builder l'application landing (version anglaise d'abord)
RUN npm run build:en && \
    mkdir -p /tmp/en-build && \
    (cp -r dist/landing/browser/en /tmp/en-build/ || cp -r dist/landing/browser /tmp/en-build/en)

# Builder l'application landing (version française)
RUN npm run build:fr

# Stage de production avec nginx
FROM alpine:3.22 AS production

# nginx du paquet Alpine (et non l'image officielle) : c'est le seul moyen
# d'avoir le module Brotli, absent de `nginx:alpine`. `brotli` et `zopfli`
# servent à précompresser les fichiers au build.
RUN apk add --no-cache nginx nginx-mod-http-brotli brotli zopfli && \
    mkdir -p /usr/share/nginx/html /var/log/nginx && \
    ln -sf /dev/stdout /var/log/nginx/access.log && \
    ln -sf /dev/stderr /var/log/nginx/error.log
ARG BUILD_ENV

# Install security updates
RUN apk update && apk upgrade && \
    apk add --no-cache dumb-init && \
    rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S nginx-user && \
    adduser -S nginx-user -u 1001 -G nginx-user

# Set environment
ENV NODE_ENV=${BUILD_ENV:-production}

# Copier la configuration nginx
COPY ./apps/landing/nginx.conf /etc/nginx/nginx.conf

# Tampon de version gravé dans la configuration. Il sert la sortie forcée des
# appareils restés sur une ancienne landing : une réponse gardée par le cache
# heuristique du navigateur est servie SANS contacter le serveur, donc aucun
# en-tête ne peut les libérer. Le seul point de passage qui atteint encore
# nginx est la redirection de `/`, qui n'est jamais mise en cache : elle envoie
# une fois par appareil vers `/fr/?r=<version>`, une URL qu'il ne peut pas
# avoir en cache. Le cookie `idem_fresh` posé au même moment évite que la
# redirection reste polluée les fois suivantes.
RUN sed -i "s/__IDEM_RELEASE__/$(date +%Y%m%d%H%M%S)/" /etc/nginx/nginx.conf && \
    grep -q "__IDEM_RELEASE__" /etc/nginx/nginx.conf && exit 1 || true

# Copier les builds des deux locales
COPY --from=builder /app/apps/landing/dist/landing/browser/fr /usr/share/nginx/html/fr
COPY --from=builder /tmp/en-build/en /usr/share/nginx/html/en

# Copier FR comme version par défaut
COPY --from=builder /app/apps/landing/dist/landing/browser/fr /usr/share/nginx/html

# Conversion WebP des images, à côté des originaux (`photo.png` ->
# `photo.png.webp`). nginx sert la version WebP aux navigateurs qui
# l'acceptent (voir la carte `$idem_webp`), l'original aux autres : aucune
# référence à changer dans les gabarits. Gain typique : 70 % sur un PNG.
#
# `-q 82` : au-delà, le gain de qualité ne se voit plus et le poids remonte.
# `-metadata none` retire les blocs EXIF, souvent plus lourds que l'image.
RUN apk add --no-cache libwebp-tools && \
    find /usr/share/nginx/html -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) \
      -size +10k \
      -exec sh -c 'cwebp -quiet -q 82 -metadata none "$1" -o "$1.webp" || rm -f "$1.webp"' _ {} \; && \
    apk del libwebp-tools

# Précompression au build : Brotli qualité 11 et gzip Zopfli, servis par
# `brotli_static` / `gzip_static`. Les deux compressent nettement mieux que la
# compression à la volée et ne coûtent aucun CPU à chaque requête. Sur un lien
# à bas débit, c'est 16 % de temps d'attente en moins sur tout le JS et le HTML.
RUN find /usr/share/nginx/html -type f \
      \( -name '*.js' -o -name '*.mjs' -o -name '*.css' -o -name '*.html' \
         -o -name '*.json' -o -name '*.svg' -o -name '*.xml' -o -name '*.txt' \
         -o -name '*.webmanifest' -o -name '*.wasm' \) \
      -size +256c \
      -exec brotli -q 11 -k -f {} \; \
      -exec zopfli --i5 {} \; && \
    nginx -t

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
