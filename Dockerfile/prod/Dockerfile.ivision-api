# iVision API — Express + le moteur créatif partagé (apps/ivision/core).
# Rendu vidéo et visuels : Chromium (Puppeteer) et ffmpeg, comme l'API IDEM.
ARG BUILD_ENV=production
# Montage des prises de parole : Whisper en local (whisper.cpp) et son modèle, embarqués.
ARG WHISPER_VERSION=v1.9.1
ARG WHISPER_MODEL_FILE=ggml-large-v3-turbo-q5_0.bin

FROM alpine:3.20 AS whisper
ARG WHISPER_VERSION
ARG WHISPER_MODEL_FILE
RUN apk add --no-cache build-base cmake git curl
RUN git clone --depth 1 --branch ${WHISPER_VERSION} https://github.com/ggml-org/whisper.cpp /src \
  && cmake -S /src -B /src/build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_EXAMPLES=ON -DGGML_NATIVE=OFF \
  && cmake --build /src/build --config Release -j --target whisper-cli \
  && install -m 0755 /src/build/bin/whisper-cli /usr/local/bin/whisper-cli
RUN mkdir -p /models && curl -fsSL -o /models/${WHISPER_MODEL_FILE} https://huggingface.co/ggerganov/whisper.cpp/resolve/main/${WHISPER_MODEL_FILE}

FROM node:20-alpine AS builder

RUN apk update && apk upgrade && apk add --no-cache dumb-init && rm -rf /var/cache/apk/*

WORKDIR /app

COPY ./packages/shared-models ./packages/shared-models
COPY ./packages/shared-styles ./packages/shared-styles
COPY ./packages/graphic-engine ./packages/graphic-engine
# Le langage de mouvement et son compilateur (vidéos) : importé par le cœur iVision par chemin relatif.
COPY ./packages/motion-compiler ./packages/motion-compiler
COPY ./apps/ivision/core ./apps/ivision/core
COPY ./apps/ivision/api ./apps/ivision/api

# Une seule installation pour le moteur ET l'API, dans apps/ivision/node_modules : c'est le
# dossier parent commun d'où Node résout les modules des deux (sources et dist/).
WORKDIR /app/apps/ivision
# Le moteur graphique (@idem/graphic-engine) est compilé avec l'API (voir plus bas) : seules ses
# dépendances sont installées ici.
RUN node -e "\
  const c = require('./core/package.json'), a = require('./api/package.json'), g = require('../../packages/graphic-engine/package.json');\
  const own = (deps) => Object.fromEntries(Object.entries(deps || {}).filter(([name]) => !name.startsWith('@idem/')));\
  require('fs').writeFileSync('package.json', JSON.stringify({ name: 'ivision-runtime', private: true,\
    dependencies: { ...g.dependencies, ...own(c.dependencies), ...a.dependencies, '@idem/shared-styles': 'file:../../packages/shared-styles' },\
    devDependencies: { ...a.devDependencies } }, null, 2));" \
  && PUPPETEER_SKIP_DOWNLOAD=true npm install --legacy-peer-deps && npm cache clean --force

# Compilation (dist/apps/ivision/{api,core} et dist/packages/graphic-engine). Les sources du moteur graphique vivent dans /app/packages : le lien
# /app/node_modules leur donne les dépendances installées ci-dessus, le temps de la compilation.
RUN ln -s /app/apps/ivision/node_modules /app/node_modules
WORKDIR /app/apps/ivision/api
RUN npm run build

# Les dépendances de développement ne partent pas en production.
WORKDIR /app/apps/ivision
RUN npm prune --omit=dev --legacy-peer-deps

# @idem/graphic-engine, compilé avec l'API (dist/packages/graphic-engine/src), posé sous son nom APRÈS
# l'élagage (npm le tiendrait sinon pour un paquet étranger) : le cœur iVision l'importe par ce nom.
RUN mkdir -p node_modules/@idem/graphic-engine \
    && cp -r api/dist/packages/graphic-engine/src/. node_modules/@idem/graphic-engine/ \
    && node -e "require('fs').writeFileSync('node_modules/@idem/graphic-engine/package.json', JSON.stringify({ name: '@idem/graphic-engine', version: '1.0.0', main: 'index.js' }))"

FROM node:20-alpine AS production
ARG BUILD_ENV
ARG WHISPER_MODEL_FILE

RUN apk update && apk upgrade && \
    apk add --no-cache dumb-init chromium nss freetype harfbuzz ca-certificates ttf-freefont ffmpeg libstdc++ libgomp && \
    rm -rf /var/cache/apk/*

RUN addgroup -g 1001 -S nodejs && adduser -S ivision -u 1001

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV NODE_ENV=${BUILD_ENV:-production}
ENV PORT=3006

COPY --from=whisper /usr/local/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=whisper /models /opt/whisper
ENV WHISPER_BIN=/usr/local/bin/whisper-cli
ENV WHISPER_MODEL=/opt/whisper/${WHISPER_MODEL_FILE}

WORKDIR /app/apps/ivision/api
COPY --from=builder --chown=ivision:nodejs /app/packages /app/packages
COPY --from=builder --chown=ivision:nodejs /app/apps/ivision/node_modules /app/apps/ivision/node_modules
COPY --from=builder --chown=ivision:nodejs /app/apps/ivision/api/package.json ./package.json
COPY --from=builder --chown=ivision:nodejs /app/apps/ivision/api/dist ./dist
# Les sources du runtime vidéo (kit, harnais, lecteur, exemples) : esbuild les compile avec chaque film.
COPY --from=builder --chown=ivision:nodejs /app/apps/ivision/core/motion ./dist/apps/ivision/core/motion

RUN mkdir -p /app/apps/ivision/api/logs && chown -R ivision:nodejs /app/apps/ivision/api/logs
USER ivision

EXPOSE 3006
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/apps/ivision/api/src/index.js"]
