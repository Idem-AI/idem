# iVision web — Angular 20, servi par nginx.
ARG BUILD_ENV=production

FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY ./packages ./packages
COPY ./apps/ivision/web ./apps/ivision/web

# Angular, Tailwind et ngx-translate sont ceux du monorepo (dépendances des espaces de travail).
RUN npm install --legacy-peer-deps

WORKDIR /app/apps/ivision/web

# Le .env du serveur fixe les adresses (IVISION_API_URL, SERVICES_API_URL, SERVICES_DASHBOARD_URL) :
# scripts/set-env.js échoue si l'une manque, plutôt que de livrer un front branché ailleurs.
COPY .env .env

RUN npm run build

FROM nginx:alpine AS production
ARG BUILD_ENV

RUN apk update && apk upgrade && apk add --no-cache dumb-init && rm -rf /var/cache/apk/*

ENV NODE_ENV=${BUILD_ENV:-production}

COPY ./apps/ivision/web/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/apps/ivision/web/dist/ivision-web/browser /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
